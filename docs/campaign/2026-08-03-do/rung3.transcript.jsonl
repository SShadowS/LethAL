{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HbnkQiPNzWnbASr11cVsMT","type":"tool_result","content":"1\tcodeunit 6175297 \"CDO Send Cust. Statement Mgt.\"\n2\t{\n3\t    trigger OnRun()\n4\t    var\n5\t        DOCoreEventHandler: Codeunit \"CDO Core Event Handler\";\n6\t    begin\n7\t        if DOCoreEventHandler.IsFeatureEnabled('AUTSTATEMENT') then\n8\t            CreateOrSendAutStatements()\n9\t        else\n10\t            SendPeriodStatements();\n11\t    end;\n12\t\n13\t    var\n14\t        Text001: Label 'Sending Customer Statements...';\n15\t\n16\t    [ErrorBehavior(ErrorBehavior::Collect)]\n17\t    procedure SendPeriodStatements()\n18\t    var\n19\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n20\t        DOCustSetup: Record Customer;\n21\t        Window: Dialog;\n22\t    begin\n23\t        if GuiAllowed then\n24\t            Window.Open(Text001);\n25\t        DOCustSetup.SetRange(\"CDO Automatic statement\", DOCustSetup.\"CDO Automatic statement\"::Automatic);\n26\t        DOCustSetup.SetFilter(\"CDO Send Statement Code\", '<>%1', '');\n27\t        if DOCustSetup.FindSet() then\n28\t            repeat\n29\t                if SendCustStatement.Get(DOCustSetup.\"CDO Send Statement Code\") then\n30\t                    if ChangeAuatomaticToManual(DOCustSetup.\"No.\", DOCustSetup.\"CDO Last Automatic Date\", SendCustStatement) then begin\n31\t                        DOCustSetup.\"CDO Automatic statement\" := DOCustSetup.\"CDO Automatic statement\"::Manual;\n32\t                        DOCustSetup.Modify();\n33\t                    end else begin\n34\t                        DOCustSetup.CreateAutomaticPeriodStatement();\n35\t                        DOCustSetup.CreateAutBalanceDueStatement();\n36\t                        DOCustSetup.Find();\n37\t                        DOCustSetup.\"CDO Last Automatic Date\" := WorkDate();\n38\t                        DOCustSetup.Modify();\n39\t                    end;\n40\t                Commit();\n41\t            until DOCustSetup.Next() = 0;\n42\t    end;\n43\t\n44\t    procedure ChangeAuatomaticToManual(CustNo: Code[20]; LastDate: Date; SendCustStatement: Record \"CDO Send Customer Statement\"): Boolean\n45\t    begin\n46\t        exit(ChangeAutomaticToManual(CustNo, LastDate, SendCustStatement.\"Change to manual on Reminder\", SendCustStatement.\"Change to manual on Fin.Chr.M.\"));\n47\t    end;\n48\t\n49\t    local procedure ChangeAutomaticToManual(CustNo: Code[20]; LastDate: Date; ChangeManualReminder: Boolean; ChangeManualFinCharge: Boolean): Boolean\n50\t    var\n51\t        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n52\t    begin\n53\t        if LastDate = 0D then\n54\t            exit;\n55\t        if (ChangeManualFinCharge = false) and (ChangeManualReminder = false) then\n56\t            exit;\n57\t\n58\t        CustLedgerEntry.SetCurrentKey(\"Customer No.\", \"Posting Date\");\n59\t        CustLedgerEntry.SetRange(\"Customer No.\", CustNo);\n60\t        CustLedgerEntry.SetFilter(\"Posting Date\", '>%1', LastDate);\n61\t\n62\t        if ChangeManualFinCharge and ChangeManualReminder then\n63\t            CustLedgerEntry.SetFilter(\"Document Type\", '%1|%2',\n64\t              CustLedgerEntry.\"Document Type\"::\"Finance Charge Memo\",\n65\t              CustLedgerEntry.\"Document Type\"::Reminder)\n66\t        else\n67\t            if ChangeManualFinCharge then\n68\t                CustLedgerEntry.SetRange(\"Document Type\", CustLedgerEntry.\"Document Type\"::\"Finance Charge Memo\")\n69\t            else\n70\t                if ChangeManualReminder then\n71\t                    CustLedgerEntry.SetRange(\"Document Type\", CustLedgerEntry.\"Document Type\"::Reminder);\n72\t        exit(not CustLedgerEntry.IsEmpty);\n73\t    end;\n74\t\n75\t\n76\t    [ErrorBehavior(ErrorBehavior::Collect)]\n77\t    procedure CreateOrSendAutStatements()\n78\t    var\n79\t        AutDueDateStatement: Record \"CDO Aut. Due Date Statement\";\n80\t        AutomaticDocument: Record \"CDO Automatic Document\";\n81\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n82\t        Customer: Record Customer;\n83\t        Window: Dialog;\n84\t    begin\n85\t        if GuiAllowed then\n86\t            Window.Open(Text001);\n87\t\n88\t        //DOCustSetup.SETFILTER(\"Customer No.\",'10000|20000');\n89\t\n90\t        Customer.SetRange(\"CDO Automatic statement\", Customer.\"CDO Automatic statement\"::Automatic);\n91\t        Customer.SetFilter(Customer.\"CDO Automatic Documents\", '<>%1', '');\n92\t        if Customer.FindSet() then\n93\t            repeat\n94\t                if AutomaticDocument.Get(Customer.\"CDO Automatic Documents\") then begin\n95\t                    if AutomaticDocument.\"Automatic Period Statement\" <> '' then\n96\t                        if AutomaticPeriodStatement.Get(AutomaticDocument.\"Automatic Period Statement\") then begin\n97\t                            AutomaticPeriodStatement.TestField(\"E-Mail Template Code\");\n98\t                            CreateAutomaticPeriodStatement(Customer, AutomaticPeriodStatement);\n99\t                            Commit();\n100\t                        end;\n101\t                    if AutomaticDocument.\"Automatic Due Date Statement\" <> '' then\n102\t                        if AutDueDateStatement.Get(AutomaticDocument.\"Automatic Due Date Statement\") then begin\n103\t                            AutDueDateStatement.TestField(\"E-Mail Template Code\");\n104\t                            CreateAutomaticDueDateStatement(Customer, AutDueDateStatement);\n105\t                            Commit();\n106\t                        end;\n107\t                end;\n108\t            until Customer.Next() = 0;\n109\t    end;\n110\t\n111\t    local procedure CreateAutomaticDueDateStatement(var Customer: Record Customer; AutDueDateStatement: Record \"CDO Aut. Due Date Statement\")\n112\t    var\n113\t        EndDate: Date;\n114\t        LastStatementDate: Date;\n115\t        StartDate: Date;\n116\t\n117\t    begin\n118\t        if Format(AutDueDateStatement.\"Send statement if Bal.Due D.F.\") <> '' then begin\n119\t            AutDueDateStatement.TestField(\"E-Mail Template Code\");\n120\t\n121\t            EndDate := CalcDate(AutDueDateStatement.\"Send statement if Bal.Due D.F.\", WorkDate());\n122\t\n123\t            LastStatementDate := GetLastStatementSendingDate(Customer.\"No.\", AutDueDateStatement.\"E-Mail Template Code\"); // ToDo\n124\t\n125\t            if LastStatementDate >= EndDate then\n126\t                exit;\n127\t\n128\t            if LastStatementDate <> 0D then\n129\t                StartDate := LastStatementDate + 1\n130\t            else\n131\t                StartDate := CalcDate('<-1M>', EndDate);\n132\t\n133\t            if OpenEntriesInDueDatePeriod(Customer.\"No.\", StartDate, EndDate) then\n134\t                CreateStatement(1, AutDueDateStatement.Output, Customer.\"No.\", WorkDate(), StartDate, EndDate, AutDueDateStatement.\"E-Mail Template Code\");\n135\t        end;\n136\t    end;\n137\t\n138\t    local procedure OpenEntriesInDueDatePeriod(CustNo: Code[20]; StartDate: Date; EndDate: Date): Boolean\n139\t    var\n140\t        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n141\t    begin\n142\t        CustLedgerEntry.SetCurrentKey(\"Customer No.\", Open, Positive, \"Due Date\", \"Currency Code\");\n143\t        CustLedgerEntry.SetRange(\"Customer No.\", CustNo);\n144\t        CustLedgerEntry.SetRange(Open, true);\n145\t        CustLedgerEntry.SetRange(Positive, true);\n146\t        CustLedgerEntry.SetRange(\"Due Date\", StartDate, EndDate);\n147\t        exit(not CustLedgerEntry.IsEmpty);\n148\t    end;\n149\t\n150\t    local procedure CreateAutomaticPeriodStatement(var Customer: Record Customer; var AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\"): Boolean\n151\t    var\n152\t        EndDate: Date;\n153\t        LastSendingDate: Date;\n154\t        NextSendingDate: Date;\n155\t        StartDate: Date;\n156\t    begin\n157\t        LastSendingDate := GetLastPerStatementSendingDate(Customer.\"No.\", AutomaticPeriodStatement.\"E-Mail Template Code\");\n158\t\n159\t        if ChangeAutomaticToManual(Customer.\"No.\", LastSendingDate, AutomaticPeriodStatement.\"Change to manual on Reminder\", AutomaticPeriodStatement.\"Change to manual on Fin.Chr.M.\") then begin\n160\t            Customer.\"CDO Automatic statement\" := Customer.\"CDO Automatic statement\"::Manual;\n161\t            Customer.Modify();\n162\t            exit(false);\n163\t        end;\n164\t\n165\t        if LastSendingDate = 0D then\n166\t            LastSendingDate := CalcDate('<-1M>', WorkDate());\n167\t\n168\t        NextSendingDate := AutomaticPeriodStatement.NextSendingDate(LastSendingDate);\n169\t        if NextSendingDate > WorkDate() then\n170\t            exit;\n171\t        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, NextSendingDate, Customer.\"No.\");\n172\t\n173\t        if CheckForStatement(Customer.\"No.\", StartDate, EndDate, AutomaticPeriodStatement) then\n174\t            if CreateStatement(0, AutomaticPeriodStatement.Output, Customer.\"No.\", NextSendingDate, StartDate, EndDate, AutomaticPeriodStatement.\"E-Mail Template Code\") then\n175\t                exit(true);\n176\t\n177\t        // MESSAGE('Customer No.: %1\\Next Sending Date: %2\\Period: %3 - %4',\n178\t        //  DOCustSetup.\"Customer No.\",\n179\t        //  NextSendingDate,\n180\t        //  StartDate,EndDate);\n181\t    end;\n182\t\n183\t    procedure CreateStatement(Type: option Period,\"Balance Due\"; Handle: option Journal,\"E-Mail\"; CustomerNo: Code[20]; SendingDate: Date; StartDate: Date; EndDate: Date; EMailTemplateCode: Code[20]) Created: Boolean\n184\t    var\n185\t        StatementJournalLine: Record \"CDO Statement Journal Line\";\n186\t        Void: Boolean;\n187\t    begin\n188\t        Void := StatementJournalLine.FindLast();\n189\t\n190\t        StatementJournalLine.Init();\n191\t        StatementJournalLine.\"Line No.\" += 1;\n192\t        StatementJournalLine.Type := Type;\n193\t        StatementJournalLine.\"Customer No.\" := CustomerNo;\n194\t        StatementJournalLine.\"Planned Sending Date\" := SendingDate;\n195\t        StatementJournalLine.\"Start Date\" := StartDate;\n196\t        StatementJournalLine.\"End Date\" := EndDate;\n197\t        StatementJournalLine.\"E-Mail Template Code\" := EMailTemplateCode;\n198\t\n199\t        case Handle of\n200\t            Handle::Journal:\n201\t                if not StatementJournalLine.RecExists() then begin\n202\t                    StatementJournalLine.CreatePDF();\n203\t                    // Only insert journal line if PDF was actually created\n204\t                    if StatementJournalLine.\"Statement PDF\".HasValue() then begin\n205\t                        StatementJournalLine.Insert();\n206\t                        Created := true;\n207\t                    end;\n208\t                end;\n209\t            Handle::\"E-Mail\":\n210\t                begin\n211\t                    StatementJournalLine.CreatePDF();\n212\t                    if StatementJournalLine.\"Statement PDF\".HasValue() then begin\n213\t                        StatementJournalLine.SendMail(true, true, false);\n214\t                        Created := true;\n215\t                    end;\n216\t                end;\n217\t        end;\n218\t    end;\n219\t\n220\t    local procedure GetLastPerStatementSendingDate(CustomerNo: Code[20]; EMailTemplateCode: Code[20]) ReturnValue: Date\n221\t    var\n222\t        EMailLog: Record \"CDO E-Mail Log\";\n223\t    begin\n224\t        if EMailTemplateCode = '' then\n225\t            exit;\n226\t\n227\t        EMailLog.SetCurrentKey(\"Table No.\", \"Primary Key Field 1 Value\", \"Primary Key Field 2 Value\");\n228\t        EMailLog.SetRange(\"E-Mail Template Code\", EMailTemplateCode);\n229\t        EMailLog.SetRange(\"Table No.\", Database::Customer);\n230\t        EMailLog.SetRange(\"Primary Key Field 1 Value\", CustomerNo);\n231\t        EMailLog.SetRange(\"Document Type\", EMailLog.\"Document Type\"::\"Period Statement\");\n232\t\n233\t        EMailLog.SetFilter(\"Planned Sending Date\", '<>%1', 0D);\n234\t        if EMailLog.IsEmpty then\n235\t            EMailLog.SetRange(\"Planned Sending Date\");\n236\t\n237\t        if EMailLog.FindSet() then\n238\t            repeat\n239\t                if EMailLog.\"Planned Sending Date\" <> 0D then begin\n240\t                    if EMailLog.\"Planned Sending Date\" > ReturnValue then\n241\t                        ReturnValue := EMailLog.\"Planned Sending Date\";\n242\t                end else\n243\t                    if DT2Date(EMailLog.\"Date Time\") > ReturnValue then\n244\t                        ReturnValue := DT2Date(EMailLog.\"Date Time\");\n245\t            until EMailLog.Next() = 0;\n246\t    end;\n247\t\n248\t    local procedure GetLastStatementSendingDate(CustomerNo: Code[20]; EMailTemplateCode: Code[20]) ReturnValue: Date\n249\t    var\n250\t        EMailLog: Record \"CDO E-Mail Log\";\n251\t    begin\n252\t        if EMailTemplateCode = '' then\n253\t            exit;\n254\t\n255\t        EMailLog.SetCurrentKey(\"Table No.\", \"Primary Key Field 1 Value\", \"Primary Key Field 2 Value\");\n256\t        EMailLog.SetRange(\"E-Mail Template Code\", EMailTemplateCode);\n257\t        EMailLog.SetRange(\"Table No.\", Database::Customer);\n258\t        EMailLog.SetRange(\"Primary Key Field 1 Value\", CustomerNo);\n259\t        EMailLog.SetRange(\"Document Type\", EMailLog.\"Document Type\"::\"Period Statement\", EMailLog.\"Document Type\"::Statement);\n260\t\n261\t        EMailLog.SetFilter(\"Planned Sending Date\", '<>%1', 0D);\n262\t        if EMailLog.IsEmpty then\n263\t            EMailLog.SetRange(\"Planned Sending Date\");\n264\t\n265\t        if EMailLog.FindSet() then\n266\t            repeat\n267\t                if EMailLog.\"Planned Sending Date\" <> 0D then begin\n268\t                    if EMailLog.\"Planned Sending Date\" > ReturnValue then\n269\t                        ReturnValue := EMailLog.\"Planned Sending Date\";\n270\t                end else\n271\t                    if DT2Date(EMailLog.\"Date Time\") > ReturnValue then\n272\t                        ReturnValue := DT2Date(EMailLog.\"Date Time\");\n273\t            until EMailLog.Next() = 0;\n274\t    end;\n275\t\n276\t\n277\t    local procedure CheckForStatement(CustomerNo: Code[20]; StartDate: Date; EndDate: Date; AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\"): Boolean\n278\t    var\n279\t        Cust: Record Customer;\n280\t    begin\n281\t        if not Cust.Get(CustomerNo) then\n282\t            exit(false);\n283\t\n284\t        if AutomaticPeriodStatement.\"Do not send if neg. balance\" then begin\n285\t            Cust.SetFilter(\"Date Filter\", '..%1', EndDate);\n286\t            Cust.CalcFields(\"Net Change (LCY)\");\n287\t            if Cust.\"Net Change (LCY)\" < 0 then\n288\t                exit(false);\n289\t        end;\n290\t\n291\t        case AutomaticPeriodStatement.\"Send statement if\" of\n292\t            AutomaticPeriodStatement.\"Send statement if\"::\"Entries in period\":\n293\t                exit(EntriesInPeriod(CustomerNo, StartDate, EndDate));\n294\t\n295\t            AutomaticPeriodStatement.\"Send statement if\"::Balance:\n296\t                exit(CalcBalance(Cust, EndDate));\n297\t\n298\t            AutomaticPeriodStatement.\"Send statement if\"::\"Balance due\":\n299\t                exit(BalanceDue(Cust, EndDate));\n300\t\n301\t            AutomaticPeriodStatement.\"Send statement if\"::\"Entries in period or balance\":\n302\t                exit(EntriesInPeriod(CustomerNo, StartDate, EndDate) or CalcBalance(Cust, EndDate));\n303\t\n304\t            AutomaticPeriodStatement.\"Send statement if\"::\"Entries in period or balance due\":\n305\t                exit(EntriesInPeriod(CustomerNo, StartDate, EndDate) or BalanceDue(Cust, EndDate));\n306\t        end;\n307\t\n308\t        exit(false);\n309\t    end;\n310\t\n311\t    local procedure EntriesInPeriod(CustNo: Code[20]; StartDate: Date; EndDate: Date): Boolean\n312\t    var\n313\t        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n314\t    begin\n315\t        CustLedgerEntry.SetCurrentKey(\"Customer No.\", \"Posting Date\");\n316\t        CustLedgerEntry.SetRange(\"Customer No.\", CustNo);\n317\t        CustLedgerEntry.SetRange(\"Posting Date\", StartDate, EndDate);\n318\t        exit(not CustLedgerEntry.IsEmpty);\n319\t    end;\n320\t\n321\t    local procedure CalcBalance(Cust: Record Customer; EndDate: Date): Boolean\n322\t    begin\n323\t        Cust.SetFilter(\"Date Filter\", '..%1', EndDate);\n324\t        Cust.CalcFields(\"Net Change (LCY)\");\n325\t        exit(Cust.\"Net Change (LCY)\" <> 0);\n326\t    end;\n327\t\n328\t    local procedure BalanceDue(Cust: Record Customer; EndDate: Date): Boolean\n329\t    begin\n330\t        Cust.SetFilter(\"Date Filter\", '..%1', EndDate);\n331\t        Cust.CalcFields(\"Balance Due (LCY)\");\n332\t        exit(Cust.\"Balance Due (LCY)\" <> 0);\n333\t    end;\n334\t\n335\t    internal procedure IsCustomerStatementReport(ReportID: Integer; var RecordFilter: RecordRef): Boolean\n336\t    var\n337\t        DOSetup: Record \"CDO Setup\";\n338\t        ReportSelection: Record \"Report Selections\";\n339\t        EMailTemplateHeader: Record \"CDO E-Mail Template Header\";\n340\t        ReportNo: Integer;\n341\t    begin\n342\t        // Only applies to Customer records\n343\t        if RecordFilter.Number() <> Database::Customer then\n344\t            exit(false);\n345\t\n346\t        // Check if this report is used for Customer Statements in Email Templates\n347\t        EMailTemplateHeader.SetRange(\"Report-ID\", ReportID);\n348\t        EMailTemplateHeader.SetRange(\"Report Selection Usage\", EMailTemplateHeader.\"Report Selection Usage\"::\"C.Statement\");\n349\t        if not EMailTemplateHeader.IsEmpty() then\n350\t            exit(true);\n351\t\n352\t        // Check configured customer statement report in CDO Setup\n353\t        if DOSetup.Get() then begin\n354\t            ReportNo := DOSetup.GetCustStatementReportNo(false);\n355\t            if (ReportNo > 0) and (ReportID = ReportNo) then\n356\t                exit(true);\n357\t        end;\n358\t\n359\t        // Check standard BC statement reports\n360\t        exit(ReportID in [Report::Statement, Report::\"Standard Statement\"]);\n361\t    end;\n362\t}\n363\t\n364\t"}]},"parent_tool_use_id":null,"session_id":"7f3c1a92-5d84-4b16-9e07-2c8a6f0d3b51","uuid":"ca14b1bb-b117-49f9-996a-619c3ff51b9f","timestamp":"2026-08-04T22:48:44.015Z","tool_use_result":{"type":"text","file":{"filePath":"U:\\Git\\do-lethal\\Cloud\\Al\\Codeunit\\Codeunit 6175297 CDO Send Cust. Statement Mgt.al","content":"codeunit 6175297 \"CDO Send Cust. Statement Mgt.\"\n{\n    trigger OnRun()\n    var\n        DOCoreEventHandler: Codeunit \"CDO Core Event Handler\";\n    begin\n        if DOCoreEventHandler.IsFeatureEnabled('AUTSTATEMENT') then\n            CreateOrSendAutStatements()\n        else\n            SendPeriodStatements();\n    end;\n\n    var\n        Text001: Label 'Sending Customer Statements...';\n\n    [ErrorBehavior(ErrorBehavior::Collect)]\n    procedure SendPeriodStatements()\n    var\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        DOCustSetup: Record Customer;\n        Window: Dialog;\n    begin\n        if GuiAllowed then\n            Window.Open(Text001);\n        DOCustSetup.SetRange(\"CDO Automatic statement\", DOCustSetup.\"CDO Automatic statement\"::Automatic);\n        DOCustSetup.SetFilter(\"CDO Send Statement Code\", '<>%1', '');\n        if DOCustSetup.FindSet() then\n            repeat\n                if SendCustStatement.Get(DOCustSetup.\"CDO Send Statement Code\") then\n                    if ChangeAuatomaticToManual(DOCustSetup.\"No.\", DOCustSetup.\"CDO Last Automatic Date\", SendCustStatement) then begin\n                        DOCustSetup.\"CDO Automatic statement\" := DOCustSetup.\"CDO Automatic statement\"::Manual;\n                        DOCustSetup.Modify();\n                    end else begin\n                        DOCustSetup.CreateAutomaticPeriodStatement();\n                        DOCustSetup.CreateAutBalanceDueStatement();\n                        DOCustSetup.Find();\n                        DOCustSetup.\"CDO Last Automatic Date\" := WorkDate();\n                        DOCustSetup.Modify();\n                    end;\n                Commit();\n            until DOCustSetup.Next() = 0;\n    end;\n\n    procedure ChangeAuatomaticToManual(CustNo: Code[20]; LastDate: Date; SendCustStatement: Record \"CDO Send Customer Statement\"): Boolean\n    begin\n        exit(ChangeAutomaticToManual(CustNo, LastDate, SendCustStatement.\"Change to manual on Reminder\", SendCustStatement.\"Change to manual on Fin.Chr.M.\"));\n    end;\n\n    local procedure ChangeAutomaticToManual(CustNo: Code[20]; LastDate: Date; ChangeManualReminder: Boolean; ChangeManualFinCharge: Boolean): Boolean\n    var\n        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n    begin\n        if LastDate = 0D then\n            exit;\n        if (ChangeManualFinCharge = false) and (ChangeManualReminder = false) then\n            exit;\n\n        CustLedgerEntry.SetCurrentKey(\"Customer No.\", \"Posting Date\");\n        CustLedgerEntry.SetRange(\"Customer No.\", CustNo);\n        CustLedgerEntry.SetFilter(\"Posting Date\", '>%1', LastDate);\n\n        if ChangeManualFinCharge and ChangeManualReminder then\n            CustLedgerEntry.SetFilter(\"Document Type\", '%1|%2',\n              CustLedgerEntry.\"Document Type\"::\"Finance Charge Memo\",\n              CustLedgerEntry.\"Document Type\"::Reminder)\n        else\n            if ChangeManualFinCharge then\n                CustLedgerEntry.SetRange(\"Document Type\", CustLedgerEntry.\"Document Type\"::\"Finance Charge Memo\")\n            else\n                if ChangeManualReminder then\n                    CustLedgerEntry.SetRange(\"Document Type\", CustLedgerEntry.\"Document Type\"::Reminder);\n        exit(not CustLedgerEntry.IsEmpty);\n    end;\n\n\n    [ErrorBehavior(ErrorBehavior::Collect)]\n    procedure CreateOrSendAutStatements()\n    var\n        AutDueDateStatement: Record \"CDO Aut. Due Date Statement\";\n        AutomaticDocument: Record \"CDO Automatic Document\";\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Customer: Record Customer;\n        Window: Dialog;\n    begin\n        if GuiAllowed then\n            Window.Open(Text001);\n\n        //DOCustSetup.SETFILTER(\"Customer No.\",'10000|20000');\n\n        Customer.SetRange(\"CDO Automatic statement\", Customer.\"CDO Automatic statement\"::Automatic);\n        Customer.SetFilter(Customer.\"CDO Automatic Documents\", '<>%1', '');\n        if Customer.FindSet() then\n            repeat\n                if AutomaticDocument.Get(Customer.\"CDO Automatic Documents\") then begin\n                    if AutomaticDocument.\"Automatic Period Statement\" <> '' then\n                        if AutomaticPeriodStatement.Get(AutomaticDocument.\"Automatic Period Statement\") then begin\n                            AutomaticPeriodStatement.TestField(\"E-Mail Template Code\");\n                            CreateAutomaticPeriodStatement(Customer, AutomaticPeriodStatement);\n                            Commit();\n                        end;\n                    if AutomaticDocument.\"Automatic Due Date Statement\" <> '' then\n                        if AutDueDateStatement.Get(AutomaticDocument.\"Automatic Due Date Statement\") then begin\n                            AutDueDateStatement.TestField(\"E-Mail Template Code\");\n                            CreateAutomaticDueDateStatement(Customer, AutDueDateStatement);\n                            Commit();\n                        end;\n                end;\n            until Customer.Next() = 0;\n    end;\n\n    local procedure CreateAutomaticDueDateStatement(var Customer: Record Customer; AutDueDateStatement: Record \"CDO Aut. Due Date Statement\")\n    var\n        EndDate: Date;\n        LastStatementDate: Date;\n        StartDate: Date;\n\n    begin\n        if Format(AutDueDateStatement.\"Send statement if Bal.Due D.F.\") <> '' then begin\n            AutDueDateStatement.TestField(\"E-Mail Template Code\");\n\n            EndDate := CalcDate(AutDueDateStatement.\"Send statement if Bal.Due D.F.\", WorkDate());\n\n            LastStatementDate := GetLastStatementSendingDate(Customer.\"No.\", AutDueDateStatement.\"E-Mail Template Code\"); // ToDo\n\n            if LastStatementDate >= EndDate then\n                exit;\n\n            if LastStatementDate <> 0D then\n                StartDate := LastStatementDate + 1\n            else\n                StartDate := CalcDate('<-1M>', EndDate);\n\n            if OpenEntriesInDueDatePeriod(Customer.\"No.\", StartDate, EndDate) then\n                CreateStatement(1, AutDueDateStatement.Output, Customer.\"No.\", WorkDate(), StartDate, EndDate, AutDueDateStatement.\"E-Mail Template Code\");\n        end;\n    end;\n\n    local procedure OpenEntriesInDueDatePeriod(CustNo: Code[20]; StartDate: Date; EndDate: Date): Boolean\n    var\n        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n    begin\n        CustLedgerEntry.SetCurrentKey(\"Customer No.\", Open, Positive, \"Due Date\", \"Currency Code\");\n        CustLedgerEntry.SetRange(\"Customer No.\", CustNo);\n        CustLedgerEntry.SetRange(Open, true);\n        CustLedgerEntry.SetRange(Positive, true);\n        CustLedgerEntry.SetRange(\"Due Date\", StartDate, EndDate);\n        exit(not CustLedgerEntry.IsEmpty);\n    end;\n\n    local procedure CreateAutomaticPeriodStatement(var Customer: Record Customer; var AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\"): Boolean\n    var\n        EndDate: Date;\n        LastSendingDate: Date;\n        NextSendingDate: Date;\n        StartDate: Date;\n    begin\n        LastSendingDate := GetLastPerStatementSendingDate(Customer.\"No.\", AutomaticPeriodStatement.\"E-Mail Template Code\");\n\n        if ChangeAutomaticToManual(Customer.\"No.\", LastSendingDate, AutomaticPeriodStatement.\"Change to manual on Reminder\", AutomaticPeriodStatement.\"Change to manual on Fin.Chr.M.\") then begin\n            Customer.\"CDO Automatic statement\" := Customer.\"CDO Automatic statement\"::Manual;\n            Customer.Modify();\n            exit(false);\n        end;\n\n        if LastSendingDate = 0D then\n            LastSendingDate := CalcDate('<-1M>', WorkDate());\n\n        NextSendingDate := AutomaticPeriodStatement.NextSendingDate(LastSendingDate);\n        if NextSendingDate > WorkDate() then\n            exit;\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, NextSendingDate, Customer.\"No.\");\n\n        if CheckForStatement(Customer.\"No.\", StartDate, EndDate, AutomaticPeriodStatement) then\n            if CreateStatement(0, AutomaticPeriodStatement.Output, Customer.\"No.\", NextSendingDate, StartDate, EndDate, AutomaticPeriodStatement.\"E-Mail Template Code\") then\n                exit(true);\n\n        // MESSAGE('Customer No.: %1\\Next Sending Date: %2\\Period: %3 - %4',\n        //  DOCustSetup.\"Customer No.\",\n        //  NextSendingDate,\n        //  StartDate,EndDate);\n    end;\n\n    procedure CreateStatement(Type: option Period,\"Balance Due\"; Handle: option Journal,\"E-Mail\"; CustomerNo: Code[20]; SendingDate: Date; StartDate: Date; EndDate: Date; EMailTemplateCode: Code[20]) Created: Boolean\n    var\n        StatementJournalLine: Record \"CDO Statement Journal Line\";\n        Void: Boolean;\n    begin\n        Void := StatementJournalLine.FindLast();\n\n        StatementJournalLine.Init();\n        StatementJournalLine.\"Line No.\" += 1;\n        StatementJournalLine.Type := Type;\n        StatementJournalLine.\"Customer No.\" := CustomerNo;\n        StatementJournalLine.\"Planned Sending Date\" := SendingDate;\n        StatementJournalLine.\"Start Date\" := StartDate;\n        StatementJournalLine.\"End Date\" := EndDate;\n        StatementJournalLine.\"E-Mail Template Code\" := EMailTemplateCode;\n\n        case Handle of\n            Handle::Journal:\n                if not StatementJournalLine.RecExists() then begin\n                    StatementJournalLine.CreatePDF();\n                    // Only insert journal line if PDF was actually created\n                    if StatementJournalLine.\"Statement PDF\".HasValue() then begin\n                        StatementJournalLine.Insert();\n                        Created := true;\n                    end;\n                end;\n            Handle::\"E-Mail\":\n                begin\n                    StatementJournalLine.CreatePDF();\n                    if StatementJournalLine.\"Statement PDF\".HasValue() then begin\n                        StatementJournalLine.SendMail(true, true, false);\n                        Created := true;\n                    end;\n                end;\n        end;\n    end;\n\n    local procedure GetLastPerStatementSendingDate(CustomerNo: Code[20]; EMailTemplateCode: Code[20]) ReturnValue: Date\n    var\n        EMailLog: Record \"CDO E-Mail Log\";\n    begin\n        if EMailTemplateCode = '' then\n            exit;\n\n        EMailLog.SetCurrentKey(\"Table No.\", \"Primary Key Field 1 Value\", \"Primary Key Field 2 Value\");\n        EMailLog.SetRange(\"E-Mail Template Code\", EMailTemplateCode);\n        EMailLog.SetRange(\"Table No.\", Database::Customer);\n        EMailLog.SetRange(\"Primary Key Field 1 Value\", CustomerNo);\n        EMailLog.SetRange(\"Document Type\", EMailLog.\"Document Type\"::\"Period Statement\");\n\n        EMailLog.SetFilter(\"Planned Sending Date\", '<>%1', 0D);\n        if EMailLog.IsEmpty then\n            EMailLog.SetRange(\"Planned Sending Date\");\n\n        if EMailLog.FindSet() then\n            repeat\n                if EMailLog.\"Planned Sending Date\" <> 0D then begin\n                    if EMailLog.\"Planned Sending Date\" > ReturnValue then\n                        ReturnValue := EMailLog.\"Planned Sending Date\";\n                end else\n                    if DT2Date(EMailLog.\"Date Time\") > ReturnValue then\n                        ReturnValue := DT2Date(EMailLog.\"Date Time\");\n            until EMailLog.Next() = 0;\n    end;\n\n    local procedure GetLastStatementSendingDate(CustomerNo: Code[20]; EMailTemplateCode: Code[20]) ReturnValue: Date\n    var\n        EMailLog: Record \"CDO E-Mail Log\";\n    begin\n        if EMailTemplateCode = '' then\n            exit;\n\n        EMailLog.SetCurrentKey(\"Table No.\", \"Primary Key Field 1 Value\", \"Primary Key Field 2 Value\");\n        EMailLog.SetRange(\"E-Mail Template Code\", EMailTemplateCode);\n        EMailLog.SetRange(\"Table No.\", Database::Customer);\n        EMailLog.SetRange(\"Primary Key Field 1 Value\", CustomerNo);\n        EMailLog.SetRange(\"Document Type\", EMailLog.\"Document Type\"::\"Period Statement\", EMailLog.\"Document Type\"::Statement);\n\n        EMailLog.SetFilter(\"Planned Sending Date\", '<>%1', 0D);\n        if EMailLog.IsEmpty then\n            EMailLog.SetRange(\"Planned Sending Date\");\n\n        if EMailLog.FindSet() then\n            repeat\n                if EMailLog.\"Planned Sending Date\" <> 0D then begin\n                    if EMailLog.\"Planned Sending Date\" > ReturnValue then\n                        ReturnValue := EMailLog.\"Planned Sending Date\";\n                end else\n                    if DT2Date(EMailLog.\"Date Time\") > ReturnValue then\n                        ReturnValue := DT2Date(EMailLog.\"Date Time\");\n            until EMailLog.Next() = 0;\n    end;\n\n\n    local procedure CheckForStatement(CustomerNo: Code[20]; StartDate: Date; EndDate: Date; AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\"): Boolean\n    var\n        Cust: Record Customer;\n    begin\n        if not Cust.Get(CustomerNo) then\n            exit(false);\n\n        if AutomaticPeriodStatement.\"Do not send if neg. balance\" then begin\n            Cust.SetFilter(\"Date Filter\", '..%1', EndDate);\n            Cust.CalcFields(\"Net Change (LCY)\");\n            if Cust.\"Net Change (LCY)\" < 0 then\n                exit(false);\n        end;\n\n        case AutomaticPeriodStatement.\"Send statement if\" of\n            AutomaticPeriodStatement.\"Send statement if\"::\"Entries in period\":\n                exit(EntriesInPeriod(CustomerNo, StartDate, EndDate));\n\n            AutomaticPeriodStatement.\"Send statement if\"::Balance:\n                exit(CalcBalance(Cust, EndDate));\n\n            AutomaticPeriodStatement.\"Send statement if\"::\"Balance due\":\n                exit(BalanceDue(Cust, EndDate));\n\n            AutomaticPeriodStatement.\"Send statement if\"::\"Entries in period or balance\":\n                exit(EntriesInPeriod(CustomerNo, StartDate, EndDate) or CalcBalance(Cust, EndDate));\n\n            AutomaticPeriodStatement.\"Send statement if\"::\"Entries in period or balance due\":\n                exit(EntriesInPeriod(CustomerNo, StartDate, EndDate) or BalanceDue(Cust, EndDate));\n        end;\n\n        exit(false);\n    end;\n\n    local procedure EntriesInPeriod(CustNo: Code[20]; StartDate: Date; EndDate: Date): Boolean\n    var\n        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n    begin\n        CustLedgerEntry.SetCurrentKey(\"Customer No.\", \"Posting Date\");\n        CustLedgerEntry.SetRange(\"Customer No.\", CustNo);\n        CustLedgerEntry.SetRange(\"Posting Date\", StartDate, EndDate);\n        exit(not CustLedgerEntry.IsEmpty);\n    end;\n\n    local procedure CalcBalance(Cust: Record Customer; EndDate: Date): Boolean\n    begin\n        Cust.SetFilter(\"Date Filter\", '..%1', EndDate);\n        Cust.CalcFields(\"Net Change (LCY)\");\n        exit(Cust.\"Net Change (LCY)\" <> 0);\n    end;\n\n    local procedure BalanceDue(Cust: Record Customer; EndDate: Date): Boolean\n    begin\n        Cust.SetFilter(\"Date Filter\", '..%1', EndDate);\n        Cust.CalcFields(\"Balance Due (LCY)\");\n        exit(Cust.\"Balance Due (LCY)\" <> 0);\n    end;\n\n    internal procedure IsCustomerStatementReport(ReportID: Integer; var RecordFilter: RecordRef): Boolean\n    var\n        DOSetup: Record \"CDO Setup\";\n        ReportSelection: Record \"Report Selections\";\n        EMailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        ReportNo: Integer;\n    begin\n        // Only applies to Customer records\n        if RecordFilter.Number() <> Database::Customer then\n            exit(false);\n\n        // Check if this report is used for Customer Statements in Email Templates\n        EMailTemplateHeader.SetRange(\"Report-ID\", ReportID);\n        EMailTemplateHeader.SetRange(\"Report Selection Usage\", EMailTemplateHeader.\"Report Selection Usage\"::\"C.Statement\");\n        if not EMailTemplateHeader.IsEmpty() then\n            exit(true);\n\n        // Check configured customer statement report in CDO Setup\n        if DOSetup.Get() then begin\n            ReportNo := DOSetup.GetCustStatementReportNo(false);\n            if (ReportNo > 0) and (ReportID = ReportNo) then\n                exit(true);\n        end;\n\n        // Check standard BC statement reports\n        exit(ReportID in [Report::Statement, Report::\"Standard Statement\"]);\n    end;\n}\n\n","numLines":364,"startLine":1,"totalLines":364}}}
