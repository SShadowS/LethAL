         \"Period End Date Type\"::\"Last entry date\":\n                begin\n                    CustLedgerEntry.SETCURRENTKEY(\"Customer No.\", \"Posting Date\");\n                    CustLedgerEntry.SETRANGE(\"Customer No.\", CustomerNo);\n                    if CustLedgerEntry.FINDLAST() then\n                        EndDate := CustLedgerEntry.\"Posting Date\";\n                end;\n            \"Period End Date Type\"::\"Last open entry date\":\n                begin\n                    CustLedgerEntry.SETCURRENTKEY(\"Customer No.\", \"Posting Date\");\n                    CustLedgerEntry.SETRANGE(\"Customer No.\", CustomerNo);\n                    CustLedgerEntry.SETRANGE(Open, true);\n                    if CustLedgerEntry.FINDLAST() then\n                        EndDate := CustLedgerEntry.\"Posting Date\";\n                end;\n        end;\n\n        case \"Period Start Date Type\" of\n            \"Period Start Date Type\"::\"Date formula\":\n                begin\n                    TestField(\"Period End Date Type\", \"Period End Date Type\"::\"Date formula\");\n                    TestField(\"Period Date Formula\");\n                    GetCalcPeriodDates(StartDate, EndDate, SendingDate);\n                end;\n            \"Period Start Date Type\"::\"First open entry Date\":\n                begin\n                    CustLedgerEntry.SETCURRENTKEY(\"Customer No.\", \"Posting Date\");\n                    CustLedgerEntry.SETRANGE(\"Customer No.\", CustomerNo);\n                    CustLedgerEntry.SETRANGE(Open, true);\n                    if CustLedgerEntry.FINDFIRST() then\n                        StartDate := CustLedgerEntry.\"Posting Date\";\n                end;\n        end;\n    end;\n\n    local procedure GetCalcPeriodDates(var StartDate: Date; var EndDate: Date; SendingDate: Date)\n    var\n        CurrDate: Date;\n    begin\n        if SendingDate = 0D then\n            exit;\n\n        if Format(\"Period Date Formula\") = '' then\n            exit;\n\n        EndDate := SendingDate;\n\n        if \"Period start day of month\" > 0 then\n            CurrDate := DMY2Date(\"Period start day of month\", Date2DMY(EndDate, 2), Date2DMY(EndDate, 3))\n        else\n            CurrDate := EndDate;\n        while CalcDate(\"Period Date Formula\", CurrDate) > EndDate do\n            if \"Period start day of month\" > 0 then\n                CurrDate := DMY2Date(\"Period start day of month\", Date2DMY(CurrDate - 1, 2), Date2DMY(CurrDate - 1, 3))\n            else\n                CurrDate -= 1;\n        StartDate := CurrDate;\n\n        if \"Period start day of month\" > 0 then\n            EndDate := CalcDate(\"Period Date Formula\", StartDate) - 1\n        else\n            EndDate -= 1;\n    end;\n\n    internal procedure NextSendingDate(CurrDate: Date) ReturnDate: Date\n    var\n        Diff: Integer;\n        i: Integer;\n        MonthNo: Integer;\n        Year: Integer;\n    begin\n        ReturnDate := CurrDate;\n        if \"Sending interval start day\" > 0 then begin\n            if Date2DMY(ReturnDate, 1) >= \"Sending interval start day\" then begin\n                MonthNo := Date2DMY(ReturnDate, 2) + 1;\n                Year := Date2DMY(ReturnDate, 3);\n                if MonthNo > 12 then begin\n                    MonthNo := 1;\n                    Year += 1;\n                end;\n                ReturnDate := DMY2Date(\"Sending interval start day\", MonthNo, Year);\n            end;\n\n            while (ReturnDate < CurrDate) and (i < 1000) do begin\n                i += 1;\n                ReturnDate := CalcDate(\"Sending interval\", ReturnDate);\n            end;\n            if Date2DMY(ReturnDate, 1) <> \"Sending interval start day\" then\n                ReturnDate := DMY2Date(\"Sending interval start day\", Date2DMY(ReturnDate, 2), Date2DMY(ReturnDate, 3));\n        end else\n            ReturnDate := CalcDate(\"Sending interval\", CurrDate);\n\n        if \"Sending interval Weekday\" > \"Sending interval Weekday\"::\" \" then begin\n            Diff := Date2DWY(ReturnDate, 1) - \"Sending interval Weekday\";\n            if Diff = 0 then\n                exit;\n\n            // Check if adjusting backward would cross to previous month\n            if Date2DMY(ReturnDate - Diff, 2) < Date2DMY(ReturnDate, 2) then\n                // Month boundary issue - always move forward\n                ReturnDate += 7 - Diff\n            else\n                if (Diff < 0) or (Diff <= 3) then\n                    // Current day is before target day - move forward\n                    ReturnDate -= Diff\n                else\n                    // Current day is far after target day - moving forward to next occurrence is shortest\n                    ReturnDate += 7 - Diff;\n\n            if (\"Sending interval start day\" > 0) and (\"Sending interval start day\" > Date2DMY(ReturnDate, 1)) then\n                ReturnDate += 7;\n        end;\n    end;\n}\n\n","numLines":293,"startLine":1,"totalLines":293}}}
