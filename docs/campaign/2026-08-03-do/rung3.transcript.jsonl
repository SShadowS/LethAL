ith negative balance should create journal line when \"Do not send if neg. balance\" is not set\n208\t\n209\t        // [GIVEN] Setup customer with negative balance and \"Do not send if neg. balance\" flag is false\n210\t        LibraryStatement.ClearStatementJournalLines();\n211\t        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, -500, CalcDate('<-2M>', WorkDate()));\n212\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n213\t        SendCustomerStatement.\"Do not send if neg. balance\" := false;\n214\t        SendCustomerStatement.Modify(false);\n215\t        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n216\t\n217\t        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n218\t\n219\t        // [WHEN] Automatic statement creation is triggered\n220\t        Customer.CreateAutomaticPeriodStatement();\n221\t\n222\t        // [THEN] Journal line should be created for customer with negative balance\n223\t        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n224\t        Assert.AreEqual(InitialCount + 1, FinalCount, 'Journal line should be created for customer with negative balance when flag is not set');\n225\t    end;\n226\t}"}]},"parent_tool_use_id":null,"session_id":"7f3c1a92-5d84-4b16-9e07-2c8a6f0d3b51","uuid":"9cc86225-28d1-4856-ad14-cd3d48ba9bff","timestamp":"2026-08-04T22:48:58.152Z","tool_use_result":{"type":"text","file":{"filePath":"U:\\Git\\do-lethal\\Test\\Src\\AutomaticDocuments\\CDOAutStatBalCheckTests.Codeunit.al","content":"codeunit 68874 \"CDO Aut Stat Bal Check Tests\"\n{\n    Subtype = Test;\n    TestPermissions = Disabled;\n\n    var\n        Assert: Codeunit Assert;\n        LibraryEmailTemplate: Codeunit \"CDO Library - Email Template\";\n        LibrarySetup: Codeunit \"CDO Library - Setup\";\n        LibraryStatement: Codeunit \"CDO Library - Statement\";\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure LegacySystem_CustomerWithZeroBalance_ShouldNotCreateJournalLine()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n        Customer: Record Customer;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Legacy automatic statement system should not create journal lines for zero-balance customers\n\n        // [GIVEN] Setup customer with zero balance and automatic statement configuration\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.CreateCustomerWithZeroBalance(Customer);\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] Automatic statement creation is triggered\n        Customer.CreateAutomaticPeriodStatement();\n\n        // [THEN] No journal line should be created for zero-balance customer\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount, FinalCount, 'No journal line should be created for zero-balance customer');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure LegacySystem_CustomerWithBalance_ShouldCreateJournalLine()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n        StatementJournalLine: Record \"CDO Statement Journal Line\";\n        Customer: Record Customer;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Legacy automatic statement system should create journal lines for customers with balance\n\n        // [GIVEN] Setup customer with positive balance and automatic statement configuration\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, 1000, CalcDate('<-2M>', WorkDate()));\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] Automatic statement creation is triggered\n        Customer.CreateAutomaticPeriodStatement();\n\n        // [THEN] Journal line should be created for customer with balance\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount + 1, FinalCount, 'Journal line should be created for customer with balance');\n\n        // [AND] The journal line should have PDF content\n        StatementJournalLine.SetRange(\"Customer No.\", Customer.\"No.\");\n        if StatementJournalLine.FindLast() then\n            Assert.IsTrue(StatementJournalLine.HasPDF(), 'Journal line should have PDF content');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure CustomerWithEntriesButZeroBalance_ShouldNotCreateJournalLine()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n        Customer: Record Customer;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Customer with entries but zero net balance should not create journal line when condition is \"Balance\"\n\n        // [GIVEN] Setup customer with entries that result in zero balance\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomerWithAmount(Customer, 0);\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] Automatic statement creation is triggered\n        Customer.CreateAutomaticPeriodStatement();\n\n        // [THEN] No journal line should be created\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount, FinalCount, 'No journal line should be created for customer with zero net balance');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure CustomerWithEntriesAndZeroBalance_WithEntriesInPeriodCondition_ShouldCreateJournalLine()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n        Customer: Record Customer;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Customer with entries but zero balance should create journal line when condition is \"Entries in period\"\n\n        // [GIVEN] Setup customer with entries that result in zero balance, but condition is \"Entries in period\"\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, 100, CalcDate('<-1M+10D>', WorkDate()));\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::\"Entries in period\");\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] Automatic statement creation is triggered\n        Customer.CreateAutomaticPeriodStatement();\n\n        // [THEN] Journal line should be created because there are entries in the period\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount + 1, FinalCount, 'Journal line should be created for customer with entries in period');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure DirectCreateStatementCall_ZeroBalanceCustomer_ShouldNotCreateJournalLineWhenNoPDF()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        Customer: Record Customer;\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        Created: Boolean;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Direct call to CreateStatement with zero-balance customer should not create journal line if no PDF\n\n        // [GIVEN] Setup customer with zero balance\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.CreateCustomerWithZeroBalance(Customer);\n        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] CreateStatement is called directly\n        SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(),\n            CalcDate('<-1M>', WorkDate()), CalcDate('<CM>', WorkDate()), EmailTemplateHeader.Code);\n\n        // Should handle error gracefully and not create journal line\n        Assert.ExpectedErrorCode('ReportResultEmpty');\n\n        // [THEN] No journal line should be created and Created should be false\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount, FinalCount, 'No journal line should be created when PDF is not generated');\n        Assert.IsFalse(Created, 'CreateStatement should return false when no journal line is created');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure CustomerWithNegativeBalance_WithDoNotSendNegativeBalanceFlag_ShouldNotCreateJournalLine()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n        Customer: Record Customer;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Customer with negative balance should not create journal line when \"Do not send if neg. balance\" is set\n\n        // [GIVEN] Setup customer with negative balance and \"Do not send if neg. balance\" flag\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomerWithAmount(Customer, -500);\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n        SendCustomerStatement.\"Do not send if neg. balance\" := true;\n        SendCustomerStatement.Modify();\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] Automatic statement creation is triggered\n        Customer.CreateAutomaticPeriodStatement();\n\n        // [THEN] No journal line should be created for customer with negative balance\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount, FinalCount, 'No journal line should be created for customer with negative balance when flag is set');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure CustomerWithNegativeBalance_WithoutDoNotSendNegativeBalanceFlag_ShouldCreateJournalLine()\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n        Customer: Record Customer;\n        FinalCount: Integer;\n        InitialCount: Integer;\n    begin\n        // [SCENARIO] Customer with negative balance should create journal line when \"Do not send if neg. balance\" is not set\n\n        // [GIVEN] Setup customer with negative balance and \"Do not send if neg. balance\" flag is false\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, -500, CalcDate('<-2M>', WorkDate()));\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n        SendCustomerStatement.\"Do not send if neg. balance\" := false;\n        SendCustomerStatement.Modify(false);\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] Automatic statement creation is triggered\n        Customer.CreateAutomaticPeriodStatement();\n\n        // [THEN] Journal line should be created for customer with negative balance\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount + 1, FinalCount, 'Journal line should be created for customer with negative balance when flag is not set');\n    end;\n}","numLines":226,"startLine":1,"totalLines":226}}}
