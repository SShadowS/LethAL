{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MdKRwYrLMiXmZ7tBGWsra5","type":"tool_result","content":"240\t            SendCode.\"E-Document Send Code\" := '';\n241\t\n242\t            case \"CDO On E-Mail (SMTP)\" of\n243\t                \"CDO On E-Mail (SMTP)\"::\"E-Mail\":\n244\t                    SendCode.Email := SendCode.Email::PDF;\n245\t                \"CDO On E-Mail (SMTP)\"::\"E-Mail and Print\":\n246\t                    begin\n247\t                        SendCode.Email := SendCode.Email::PDF;\n248\t                        SendCode.Print := true;\n249\t                    end;\n250\t                \"CDO On E-Mail (SMTP)\"::Print:\n251\t                    SendCode.Print := true;\n252\t                \"CDO On E-Mail (SMTP)\"::Skip:\n253\t                    SendCode.Email := SendCode.Email::Skip;\n254\t            end;\n255\t        end else\n256\t            SendCode.GetSendCode(\"CDO Send Code\", TemplateCode);\n257\t    end;\n258\t\n259\t    procedure CreateAutomaticPeriodStatement()\n260\t    var\n261\t        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n262\t        EndDate: Date;\n263\t        NextStartDate: Date;\n264\t        OldDate: Date;\n265\t        StartDate: Date;\n266\t    begin\n267\t        if \"CDO Automatic statement\" <> \"CDO Automatic statement\"::Automatic then\n268\t            exit;\n269\t\n270\t        if (\"CDO First statement start date\" <> 0D) and (\"CDO First statement start date\" > WorkDate()) then\n271\t            exit;\n272\t\n273\t        TestField(\"CDO Send Statement Code\");\n274\t        SendCustomerStatement.Get(\"CDO Send Statement Code\");\n275\t\n276\t        if Format(SendCustomerStatement.\"Period Date Formula\") <> '' then begin\n277\t            SendCustomerStatement.TestField(\"E-Mail Template Code\");\n278\t\n279\t            if (\"CDO Last per.statement startd.\" <> 0D) then\n280\t                StartDate := \"CDO Last per.statement end d.\" + 1\n281