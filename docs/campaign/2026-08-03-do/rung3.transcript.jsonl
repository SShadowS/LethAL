{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SFuJP7uBjwF1nHdV84WiZj","type":"tool_result","content":"1\tcodeunit 68857 \"CDO Aut. Period Stat. Tests\"\n2\t{\n3\t    Subtype = Test;\n4\t    TestPermissions = Disabled;\n5\t\n6\t    var\n7\t        Assert: Codeunit Assert;\n8\t        LibraryStatement: Codeunit \"CDO Library - Statement\";\n9\t\n10\t\n11\t    [Test]\n12\t    [TransactionModel(TransactionModel::AutoRollback)]\n13\t    procedure GetDescription_WhenWeekdayAndStartDay_ShouldReturnCorrectDescription()\n14\t    var\n15\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n16\t        ExpectedDescriptionLbl: Label 'Send Statement on the first Monday on or after the 1 day of the month, every 1M if customer has Balance, Period: ', Locked = true;\n17\t        Result: Text;\n18\t    begin\n19\t        // [Scenario] GetDescription returns correct description when both weekday and start day are set\n20\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n21\t        AutomaticPeriodStatement.Init();\n22\t        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n23\t        AutomaticPeriodStatement.\"Sending interval start day\" := 1;\n24\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n25\t        AutomaticPeriodStatement.\"Send statement if\" := AutomaticPeriodStatement.\"Send statement if\"::Balance;\n26\t\n27\t        // [When] Call the GetDescription method to get the description based on the set fields\n28\t        Result := AutomaticPeriodStatement.GetDescription();\n29\t\n30\t        // [Then] Verify that the result matches the expected description\n31\t        Assert.AreEqual(ExpectedDescriptionLbl, Result, 'The description does not match the expected value.');\n32\t    end;\n33\t\n34\t    [Test]\n35\t    [TransactionModel(TransactionModel::AutoRollback)]\n36\t    procedure GetDescription_WhenWeekdayOnly_ShouldReturnCorrectDescription()\n37\t    var\n38\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n39\t        ExpectedDescriptionLbl: Label 'Send Statement on Monday every 1M if customer has Balance, Period: ', Locked = true;\n40\t        Result: Text;\n41\t    begin\n42\t        // [Scenario] GetDescription returns correct description when only weekday is set\n43\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n44\t        AutomaticPeriodStatement.Init();\n45\t        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n46\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n47\t        AutomaticPeriodStatement.\"Send statement if\" := AutomaticPeriodStatement.\"Send statement if\"::Balance;\n48\t\n49\t        // [When] Call the GetDescription method to get the description based on the set fields\n50\t        Result := AutomaticPeriodStatement.GetDescription();\n51\t\n52\t        // [Then] Verify that the result matches the expected description\n53\t        Assert.AreEqual(ExpectedDescriptionLbl, Result, 'The description does not match the expected value.');\n54\t    end;\n55\t\n56\t    [Test]\n57\t    [TransactionModel(TransactionModel::AutoRollback)]\n58\t    procedure GetDescription_WhenStartDayOnly_ShouldReturnCorrectDescription()\n59\t    var\n60\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n61\t        ExpectedDescriptionLbl: Label 'Send Statement on day 1 every 1M if customer has Balance, Period: ', Locked = true;\n62\t        Result: Text;\n63\t    begin\n64\t        // [Scenario] GetDescription returns correct description when only start day is set\n65\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n66\t        AutomaticPeriodStatement.Init();\n67\t        AutomaticPeriodSta