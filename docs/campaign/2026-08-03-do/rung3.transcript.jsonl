{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MA6MwDuXy6Lj4EKXp25bS2","type":"tool_result","content":"codeunit 68854 \"CDO Library - Email Template\"\n{\n    var\n        Any: Codeunit Any;\n\n    internal procedure MockEmailTemplateHeader(ReportId: Integer; var EmailTemplate: Record \"CDO E-Mail Template Header\"; LinkedTo: Enum CDOLinkedToTable; LinkedToFieldNo: Integer)\n    begin\n        EmailTemplate.Init();\n        EmailTemplate.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplate.Code));\n        EmailTemplate.\"Report-ID\" := ReportId;\n        EmailTemplate.\"Linked To\" := LinkedTo;\n        EmailTemplate.\"Linked To Field No.\" := LinkedToFieldNo;\n        EmailTemplate.\"Use reports for email attachm.\" := true;\n        EmailTemplate.Insert();\n    end;\n\n    internal procedure MockEmailTemplateHeader(ReportId: Integer; var EmailTemplate: Record \"CDO E-Mail Template Header\"; LinkedTo: Enum CDOLinkedToTable; LinkedToFieldNo: Integer; TemplateTableNo: Integer; ReportSelectionUsage: Enum CDOReportSelectionUsage)\n    begin\n        EmailTemplate.Init();\n        EmailTemplate.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplate.Code));\n        EmailTemplate.\"Report-ID\" := ReportId;\n        EmailTemplate.\"Linked To\" := LinkedTo;\n        EmailTemplate.\"Linked To Field No.\" := LinkedToFieldNo;\n        EmailTemplate.\"Use reports for email attachm.\" := true;\n        EmailTemplate.\"First Table in Report\" := TemplateTableNo;\n        EmailTemplate.\"Report Selection Usage\" := ReportSelectionUsage;\n        EmailTemplate.Insert();\n    end;\n\n    internal procedure MockEmailTemplateLine(EmailTemplateCode: Code[20]; var EmailTemplateLine: Record \"CDO E-Mail Template Line\")\n    begin\n        EmailTemplateLine.Init();\n        EmailTemplateLine.\"E-Mail Template Code\" := EmailTemplateCode;\n        EmailTemplateLine.\"Language Code\" := '';\n        EmailTemplateLine.Enabled := true;\n        EmailTemplateLine.\"File Name\" := 'Statement_%1';\n        EmailTemplateLine.Insert();\n    end;\n\n    internal procedure MockEmailTemplate(ReportId: Integer; var EmailTemplate: Record \"CDO E-Mail Template Header\"; LinkedTo: Enum CDOLinkedToTable; LinkedToFieldNo: Integer)\n    var\n        EmailTemplateLine: Record \"CDO E-Mail Template Line\";\n    begin\n        MockEmailTemplateHeader(ReportId, EmailTemplate, LinkedTo, LinkedToFieldNo);\n        MockEmailTemplateLine(EmailTemplate.Code, EmailTemplateLine);\n    end;\n\n    internal procedure MockStatementEmailTemplate(var EmailTemplate: Record \"CDO E-Mail Template Header\")\n        MockEmailTemplateHeader(Report::\"Service - Credit Memo\", EmailTemplate, CDOLinkedToTable::Customer, 4, Database::\"Service Cr.Memo Header\", Enum::CDOReportSelectionUsage::\"SM.Credit Memo\");\n        MockEmailTemplateLine(EmailTemplate.Code, EmailTemplateLine);\n    end;\n\n    internal procedure MockIssuedReminderEmailTemplate(var EmailTemplate: Record \"CDO E-Mail Template Header\")\n    var\n        EmailTemplateLine: Record \"CDO E-Mail Template Line\";\n    begin\n        MockEmailTemplateHeader(Report::Reminder, EmailTemplate, CDOLinkedToTable::Customer, 4, Database::\"Issued Reminder Header\", Enum::CDOReportSelectionUsage::Reminder);\n        MockEmailTemplateLine(EmailTemplate.Code, EmailTemplateLine);\n    end;\n\n    internal procedure CreateCustomerForTemplate(var Customer: Record Customer)\n    begin\n        Customer.Init();\n        Customer.\"No.\" := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(Customer.\"No.\"));\n        Customer.Name := CopyStr(Any.AlphabeticText(50), 1, MaxStrLen(Customer.Name));\n        Customer.Insert();\n    end;\n\n    internal procedure CreateCustomerWithDateFilter(var Customer: Record Customer; StartDate: Date; EndDate: Date)\n    begin\n        CreateCustomerForTemplate(Customer);\n        Customer.SetFilter(\"Date Filter\", '%1..%2', StartDate, EndDate);\n    end;\n\n    internal procedure CreateVendorForTemplate(var Vendor: Record Vendor)\n    begin\n        Vendor.Init();\n        Vendor.\"No.\" := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(Vendor.\"No.\"));\n        Vendor.Name := CopyStr(Any.AlphabeticText(50), 1, MaxStrLen(Vendor.Name));\n        Vendor.Insert();\n    end;\n\n    internal procedure CreateEmailTemplateWithLanguage(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; var EmailTemplateLine: Record \"CDO E-Mail Template Line\"; LanguageCode: Code[10])\n    begin\n        CreateEmailTemplateHeaderBasic(EmailTemplateHeader);\n        CreateEmailTemplateLineWithLanguage(EmailTemplateHeader.Code, EmailTemplateLine, LanguageCode);\n    end;\n\n    internal procedure CreateEmailTemplateWithReportSelection(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; var EmailTemplateLine: Record \"CDO E-Mail Template Line\"; ReportSelectionUsage: Integer)\n    begin\n        CreateEmailTemplateWithReportSelectionAndTable(EmailTemplateHeader, EmailTemplateLine, ReportSelectionUsage, Database::Customer);\n    end;\n\n    internal procedure CreateEmailTemplateWithReportSelectionAndTable(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; var EmailTemplateLine: Record \"CDO E-Mail Template Line\"; ReportSelectionUsage: Integer; TableNo: Integer)\n    begin\n        EmailTemplateHeader.Init();\n        EmailTemplateHeader.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplateHeader.Code));\n        EmailTemplateHeader.\"Report Selection Usage\" := \"CDOReportSelectionUsage\".FromInteger(ReportSelectionUsage + 1);\n        EmailTemplateHeader.\"First Table in Report\" := TableNo;\n        EmailTemplateHeader.Insert();\n\n        CreateEmailTemplateLineWithLanguage(EmailTemplateHeader.Code, EmailTemplateLine, '');\n    end;\n\n    internal procedure CreateEmailTemplateWithReportID(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; var EmailTemplateLine: Record \"CDO E-Mail Template Line\"; ReportID: Integer)\n    begin\n        CreateEmailTemplateHeaderWithReportID(EmailTemplateHeader, ReportID);\n        CreateEmailTemplateLineWithLanguage(EmailTemplateHeader.Code, EmailTemplateLine, '');\n    end;\n\n    internal procedure CreateEmailTemplateHeaderWithReportID(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; ReportID: Integer)\n    begin\n        EmailTemplateHeader.Init();\n        EmailTemplateHeader.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplateHeader.Code));\n        EmailTemplateHeader.\"Report-ID\" := ReportID;\n        EmailTemplateHeader.\"First Table in Report\" := Database::Customer;\n        EmailTemplateHeader.Insert();\n    end;\n\n    internal procedure CreateEmailTemplateWithFirstTable(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; var EmailTemplateLine: Record \"CDO E-Mail Template Line\"; FirstTableNo: Integer)\n    begin\n        EmailTemplateHeader.Init();\n        EmailTemplateHeader.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplateHeader.Code));\n        EmailTemplateHeader.\"Report-ID\" := 0;\n        EmailTemplateHeader.\"First Table in Report\" := FirstTableNo;\n        EmailTemplateHeader.Insert();\n\n        CreateEmailTemplateLineWithLanguage(EmailTemplateHeader.Code, EmailTemplateLine, '');\n    end;\n\n    internal procedure CreateEmailTemplateHeaderBasic(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\")\n    begin\n        EmailTemplateHeader.Init();\n        EmailTemplateHeader.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplateHeader.Code));\n        EmailTemplateHeader.\"First Table in Report\" := Database::Customer;\n        EmailTemplateHeader.Insert();\n    end;\n\n    internal procedure CreateEmailTemplateLineWithLanguage(EmailTemplateCode: Code[20]; var EmailTemplateLine: Record \"CDO E-Mail Template Line\"; LanguageCode: Code[10])","is_error":false}]},"parent_tool_use_id":null,"session_id":"7f3c1a92