{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Eq5RbVoKCDoKVA6XycfBh","type":"tool_result","content":"1\tcodeunit 68929 \"CDO Send Cust. Statement Tests\"\n2\t{\n3\t    Subtype = Test;\n4\t    TestPermissions = Disabled;\n5\t\n6\t    var\n7\t        Assert: Codeunit Assert;\n8\t        LibrarySales: Codeunit \"Library - Sales\";\n9\t        LibraryEmailTemplate: Codeunit \"CDO Library - Email Template\";\n10\t        LibrarySetup: Codeunit \"CDO Library - Setup\";\n11\t        LibraryStatement: Codeunit \"CDO Library - Statement\";\n12\t\n13\t    #region ChangeAutomaticToManual Tests\n14\t\n15\t    [Test]\n16\t    [TransactionModel(TransactionModel::AutoRollback)]\n17\t    procedure ChangeAutomaticToManual_WhenNoLastDate_ShouldReturnFalse()\n18\t    var\n19\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n20\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n21\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n22\t        Result: Boolean;\n23\t    begin\n24\t        // [SCENARIO] ChangeAuatomaticToManual returns false when LastDate is 0D\n25\t        // [GIVEN] A SendCustStatement record and LastDate set to 0D\n26\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n27\t        SendCustStatement.\"Change to manual on Reminder\" := true;\n28\t        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := true;\n29\t        SendCustStatement.Modify();\n30\t\n31\t        // [WHEN] ChangeAuatomaticToManual is called with LastDate = 0D\n32\t        Result := SendCustStatementMgt.ChangeAuatomaticToManual('CUST001', 0D, SendCustStatement);\n33\t\n34\t        // [THEN] Result should be false (no change to manual)\n35\t        Assert.IsFalse(Result, 'Should return false when LastDate is 0D');\n36\t    end;\n37\t\n38\t    [Test]\n39\t    [TransactionModel(TransactionModel::AutoRollback)]\n40\t    procedure ChangeAutomaticToManual_WhenBothFlagsAreFalse_ShouldReturnFalse()\n41\t    var\n42\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n43\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n44\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n45\t        Result: Boolean;\n46\t    begin\n47\t        // [SCENARIO] ChangeAuatomaticToManual returns false when both change flags are false\n48\t        // [GIVEN] A SendCustStatement record with both change flags set to false\n49\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n50\t        SendCustStatement.\"Change to manual on Reminder\" := false;\n51\t        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := false;\n52\t        SendCustStatement.Modify();\n53\t\n54\t        // [WHEN] ChangeAuatomaticToManual is called\n55\t        Result := SendCustStatementMgt.ChangeAuatomaticToManual('CUST001', WorkDate() - 30, SendCustStatement);\n56\t\n57\t        // [THEN] Result should be false\n58\t        Assert.IsFalse(Result, 'Should return false when both change flags are false');\n59\t    end;\n60\t\n61\t    [Test]\n62\t    [TransactionModel(TransactionModel::AutoRollback)]\n63\t    procedure ChangeAutomaticToManual_WhenReminderFlagSetAndReminderExists_ShouldReturnTrue()\n64\t    var\n65\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n66\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n67\t        Customer: Record Customer;\n68\t        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n69\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n70\t        LastDate: Date;\n71\t        Result: Boolean;\n72\t    begin\n73\t        // [SCENARIO] ChangeAuatomaticToManual returns true when reminder flag is set and reminder entry exists after LastDate\n74\t        // [GIVEN] A customer with a Reminder ledger entry after LastDate\n75\t        LibrarySetup.InitializeCDOSetup();\n76\t        LibrarySales.CreateCustomer(Customer);\n77\t        LastDate := CalcDate('<-1M>', WorkDate());\n78\t\n79\t        LibrarySales.MockCustLedgerEntry(CustLedgerEntry, Customer.\"No.\");\n80\t        CustLedgerEntry.\"Document Type\" := CustLedgerEntry.\"Document Type\"::Reminder;\n81\t        CustLedgerEntry.\"Posting Date\" := CalcDate('<-1W>', WorkDate()); // After LastDate\n82\t        CustLedgerEntry.Modify();\n83\t\n84\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n85\t        SendCustStatement.\"Change to manual on Reminder\" := true;\n86\t        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := false;\n87\t        SendCustStatement.Modify();\n88\t\n89\t        // [WHEN] ChangeAuatomaticToManual is called\n90\t        Result := SendCustStatementMgt.ChangeAuatomaticToManual(Customer.\"No.\", LastDate, SendCustStatement);\n91\t\n92\t        // [THEN] Result should be true\n93\t        Assert.IsTrue(Result, 'Should return true when reminder entry exists after LastDate');\n94\t    end;\n95\t\n96\t    [Test]\n97\t    [TransactionModel(TransactionModel::AutoRollback)]\n98\t    procedure ChangeAutomaticToManual_WhenFinChargeFlagSetAndFinChargeExists_ShouldReturnTrue()\n99\t    var\n100\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n101\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n102\t        Customer: Record Customer;\n103\t        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n104\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n105\t        LastDate: Date;\n106\t        Result: Boolean;\n107\t    begin\n108\t        // [SCENARIO] ChangeAuatomaticToManual returns true when finance charge flag is set and finance charge entry exists after LastDate\n109\t        // [GIVEN] A customer with a Finance Charge Memo ledger entry after LastDate\n110\t        LibrarySetup.InitializeCDOSetup();\n111\t        LibrarySales.CreateCustomer(Customer);\n112\t        LastDate := CalcDate('<-1M>', WorkDate());\n113\t\n114\t        LibrarySales.MockCustLedgerEntry(CustLedgerEntry, Customer.\"No.\");\n115\t        CustLedgerEntry.\"Document Type\" := CustLedgerEntry.\"Document Type\"::\"Finance Charge Memo\";\n116\t        CustLedgerEntry.\"Posting Date\" := CalcDate('<-1W>', WorkDate()); // After LastDate\n117\t        CustLedgerEntry.Modify();\n118\t\n119\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n120\t        SendCustStatement.\"Change to manual on Reminder\" := false;\n121\t        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := true;\n122\t        SendCustStatement.Modify();\n123\t\n124\t        // [WHEN] ChangeAuatomaticToManual is called\n125\t        Result := SendCustStatementMgt.ChangeAuatomaticToManual(Customer.\"No.\", LastDate, SendCustStatement);\n126\t\n127\t        // [THEN] Result should be true\n128\t        Assert.IsTrue(Result, 'Should return true when finance charge entry exists after LastDate');\n129\t    end;\n130\t\n131\t    [Test]\n132\t    [TransactionModel(TransactionModel::AutoRollback)]\n133\t    procedure ChangeAutomaticToManual_WhenNoMatchingEntriesExist_ShouldReturnFalse()\n134\t    var\n135\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n136\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n137\t        Customer: Record Customer;\n138\t        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n139\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n140\t        LastDate: Date;\n141\t        Result: Boolean;\n142\t    begin\n143\t        // [SCENARIO] ChangeAuatomaticToManual returns false when flags are set but no matching entries exist\n144\t        // [GIVEN] A customer with no Reminder or Finance Charge entries after LastDate\n145\t        LibrarySetup.InitializeCDOSetup();\n146\t        LibrarySales.CreateCustomer(Customer);\n147\t        LastDate := CalcDate('<-1M>', WorkDate());\n148\t\n149\t        // Create an invoice entry (not reminder or finance charge)\n150\t        LibrarySales.MockCustLedgerEntry(CustLedgerEntry, Customer.\"No.\");\n151\t        CustLedgerEntry.\"Document Type\" := CustLedgerEntry.\"Document Type\"::Invoice;\n152\t        CustLedgerEntry.\"Posting Date\" := CalcDate('<-1W>', WorkDate());\n153\t        CustLedgerEntry.Modify();\n154\t\n155\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n156\t        SendCustStatement.\"Change to manual on Reminder\" := true;\n157\t        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := true;\n158\t        SendCustStatement.Modify();\n159\t\n160\t        // [WHEN] ChangeAuatomaticToManual is called\n161\t        Result := SendCustStatementMgt.ChangeAuatomaticToManual(Customer.\"No.\", LastDate, SendCustStatement);\n162\t\n163\t        // [THEN] Result should be false\n164\t        Assert.IsFalse(Result, 'Should return false when no matching entries exist');\n165\t    end;\n166\t\n167\t    #endregion\n168\t\n169\t    #region CreateStatement Tests\n170\t\n171\t    [Test]\n172\t    [TransactionModel(TransactionModel::AutoRollback)]\n173\t    procedure CreateStatement_WithJournalHandle_WhenRecordExists_ShouldNotDuplicate()\n174\t    var\n175\t        StatementJournalLine: Record \"CDO Statement Journal Line\";\n176\t        Customer: Record Customer;\n177\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n178\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n179\t        Created: Boolean;\n180\t        StartDate: Date;\n181\t        EndDate: Date;\n182\t        InitialCount: Integer;\n183\t        FinalCount: Integer;\n184\t    begin\n185\t        // [SCENARIO] CreateStatement with Journal handle should not duplicate existing records\n186\t        // [GIVEN] A statement journal line already exists for the customer/period/template\n187\t        LibrarySetup.InitializeCDOSetup();\n188\t        LibraryStatement.ClearStatementJournalLines();\n189\t        LibraryStatement.MockStatementForCustomer(Customer);\n190\t        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n191\t\n192\t        StartDate := CalcDate('<-CM>', WorkDate());\n193\t        EndDate := CalcDate('<+CM>', WorkDate());\n194\t\n195\t        // Create first record\n196\t        SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(), StartDate, EndDate, EmailTemplateHeader.Code);\n197\t\n198\t        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n199\t\n200\t        // [WHEN] CreateStatement is called again with same parameters\n201\t        Created := SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(), StartDate, EndDate, EmailTemplateHeader.Code);\n202\t\n203\t        // [THEN] No duplicate should be created\n204\t        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n205\t        Assert.AreEqual(InitialCount, FinalCount, 'Should not create duplicate journal lines');\n206\t        Assert.IsFalse(Created, 'Created should be false for duplicate records');\n207\t    end;\n208\t\n209\t    [Test]\n210\t    [TransactionModel(TransactionModel::AutoRollback)]\n211\t    procedure CreateStatement_WithJournalHandle_WhenPDFGenerated_ShouldInsertJournalLine()\n212\t    var\n213\t        Customer: Record Customer;\n214\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n215\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n216\t        StatementJournalLine: Record \"CDO Statement Journal Line\";\n217\t        Created: Boolean;\n218\t        StartDate: Date;\n219\t        EndDate: Date;\n220\t    begin\n221\t        // [SCENARIO] CreateStatement with Journal handle should insert journal line when PDF is generated\n222\t        // [GIVEN] A customer with statement data\n223\t        LibrarySetup.InitializeCDOSetup();\n224\t        LibraryStatement.ClearStatementJournalLines();\n225\t        LibraryStatement.MockStatementForCustomer(Customer);\n226\t        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n227\t\n228\t        StartDate := CalcDate('<-CM>', WorkDate());\n229\t        EndDate := CalcDate('<+CM>', WorkDate());\n230\t\n231\t        // [WHEN] CreateStatement is called with Journal handle (0)\n232\t        Created := SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(), StartDate, EndDate, EmailTemplateHeader.Code);\n233\t\n234\t        // [THEN] A journal line should be created with PDF content\n235\t        StatementJournalLine.SetRange(\"Customer No.\", Customer.\"No.\");\n236\t        Assert.IsTrue(StatementJournalLine.FindLast(), 'Journal line should be created');\n237\t        Assert.IsTrue(StatementJournalLine.HasPDF(), 'Journal line should have PDF content');\n238\t        Assert.IsTrue(Created, 'Created should be true when PDF is generated');\n239\t    end;\n240\t\n241\t    // SKIP: Test requires complex setup that conflicts with internal Commit calls\n242\t    // CreateStatement internally calls Commit, but without AutoRollback test data persists\n243\t    // causing conflicts on repeated runs. Needs investigation of test isolation approach.\n244\t    // [Test]\n245\t    // procedure CreateStatement_ShouldSetCorrectFieldValues()\n246\t\n247\t    #endregion\n248\t\n249\t    #region IsCustomerStatementReport Tests\n250\t\n251\t    [Test]\n252\t    [TransactionModel(TransactionModel::AutoRollback)]\n253\t    procedure IsCustomerStatementReport_WithNonCustomerTable_ShouldReturnFalse()\n254\t    var\n255\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n256\t        ItemRef: RecordRef;\n257\t        Item: Record Item;\n258\t        Result: Boolean;\n259\t    begin\n260\t        // [SCENARIO] IsCustomerStatementReport should return false for non-Customer tables\n261\t        // [GIVEN] An Item record (not Customer)\n262\t        ItemRef.GetTable(Item);\n263\t\n264\t        // [WHEN] IsCustomerStatementReport is called\n265\t        Result := SendCustStatementMgt.IsCustomerStatementReport(Report::Statement, ItemRef);\n266\t\n267\t        // [THEN] Result should be false\n268\t        Assert.IsFalse(Result, 'Should return false for non-Customer tables');\n269\t    end;\n270\t\n271\t    [Test]\n272\t    [TransactionModel(TransactionModel::AutoRollback)]\n273\t    procedure IsCustomerStatementReport_WithStatementReport_ShouldReturnTrue()\n274\t    var\n275\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n276\t        CustomerRef: RecordRef;\n277\t        Customer: Record Customer;\n278\t        Result: Boolean;\n279\t    begin\n280\t        // [SCENARIO] IsCustomerStatementReport should return true for standard Statement report\n281\t        // [GIVEN] A Customer record and Statement report ID\n282\t        CustomerRef.GetTable(Customer);\n283\t\n284\t        // [WHEN] IsCustomerStatementReport is called with Report::Statement\n285\t        Result := SendCustStatementMgt.IsCustomerStatementReport(Report::Statement, CustomerRef);\n286\t\n287\t        // [THEN] Result should be true\n288\t        Assert.IsTrue(Result, 'Should return true for standard Statement report');\n289\t    end;\n290\t\n291\t    [Test]\n292\t    [TransactionModel(TransactionModel::AutoRollback)]\n293\t    procedure IsCustomerStatementReport_WithStandardStatementReport_ShouldReturnTrue()\n294\t    var\n295\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n296\t        CustomerRef: RecordRef;\n297\t        Customer: Record Customer;\n298\t        Result: Boolean;\n299\t    begin\n300\t        // [SCENARIO] IsCustomerStatementReport should return true for Standard Statement report\n301\t        // [GIVEN] A Customer record and Standard Statement report ID\n302\t        CustomerRef.GetTable(Customer);\n303\t\n304\t        // [WHEN] IsCustomerStatementReport is called with Report::\"Standard Statement\"\n305\t        Result := SendCustStatementMgt.IsCustomerStatementReport(Report::\"Standard Statement\", CustomerRef);\n306\t\n307\t        // [THEN] Result should be true\n308\t        Assert.IsTrue(Result, 'Should return true for Standard Statement report');\n309\t    end;\n310\t\n311\t    [Test]\n312\t    [TransactionModel(TransactionModel::AutoRollback)]\n313\t    procedure IsCustomerStatementReport_WithEmailTemplateForStatements_ShouldReturnTrue()\n314\t    var\n315\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n316\t        EMailTemplateHeader: Record \"CDO E-Mail Template Header\";\n317\t        CustomerRef: RecordRef;\n318\t        Customer: Record Customer;\n319\t        CustomReportID: Integer;\n320\t        Result: Boolean;\n321\t    begin\n322\t        // [SCENARIO] IsCustomerStatementReport should return true for reports configured in Email Templates for C.Statement\n323\t        // [GIVEN] An Email Template configured for C.Statement with a custom report\n324\t        CustomReportID := 60001;\n325\t        CustomerRef.GetTable(Customer);\n326\t\n327\t        EMailTemplateHeader.Init();\n328\t        EMailTemplateHeader.Code := 'CUST-STMT-TST';\n329\t        EMailTemplateHeader.\"Report-ID\" := CustomReportID;\n330\t        EMailTemplateHeader.\"Report Selection Usage\" := EMailTemplateHeader.\"Report Selection Usage\"::\"C.Statement\";\n331\t        EMailTemplateHeader.Insert();\n332\t\n333\t        // [WHEN] IsCustomerStatementReport is called with the custom report ID\n334\t        Result := SendCustStatementMgt.IsCustomerStatementReport(CustomReportID, CustomerRef);\n335\t\n336\t        // [THEN] Result should be true\n337\t        Assert.IsTrue(Result, 'Should return true for reports configured in Email Templates for C.Statement');\n338\t    end;\n339\t\n340\t    [Test]\n341\t    [TransactionModel(TransactionModel::AutoRollback)]\n342\t    procedure IsCustomerStatementReport_WithUnrelatedReport_ShouldReturnFalse()\n343\t    var\n344\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n345\t        CustomerRef: RecordRef;\n346\t        Customer: Record Customer;\n347\t        UnrelatedReportID: Integer;\n348\t        Result: Boolean;\n349\t    begin\n350\t        // [SCENARIO] IsCustomerStatementReport should return false for unrelated reports\n351\t        // [GIVEN] A Customer record and an unrelated report ID\n352\t        UnrelatedReportID := 88888;\n353\t        CustomerRef.GetTable(Customer);\n354\t\n355\t        // [WHEN] IsCustomerStatementReport is called with an unrelated report ID\n356\t        Result := SendCustStatementMgt.IsCustomerStatementReport(UnrelatedReportID, CustomerRef);\n357\t\n358\t        // [THEN] Result should be false\n359\t        Assert.IsFalse(Result, 'Should return false for unrelated reports');\n360\t    end;\n361\t\n362\t    #endregion\n363\t\n364\t    #region SendPeriodStatements Integration Tests\n365\t\n366\t    [Test]\n367\t    procedure SendPeriodStatements_WhenCustomerSetToAutomatic_ShouldProcessCustomer()\n368\t    var\n369\t        Customer: Record Customer;\n370\t        SendCustStatement: Record \"CDO Send Customer Statement\";\n371\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n372\t        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n373\t        InitialCount: Integer;\n374\t        FinalCount: Integer;\n375\t    begin\n376\t        // [SCENARIO] SendPeriodStatements should process customers with Automatic statement setting\n377\t        // [GIVEN] A customer with automatic statement and a valid setup\n378\t        LibrarySetup.InitializeCDOSetup();\n379\t        LibraryStatement.ClearStatementJournalLines();\n380\t        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, 1000, CalcDate('<-2M>', WorkDate()));\n381\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n382\t        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustStatement.Code);\n383\t\n384\t        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n385\t\n386\t        // [WHEN] SendPeriodStatements is called\n387\t        SendCustStatementMgt.SendPeriodStatements();\n388\t\n389\t        // [THEN] Statement should be created for the customer\n390\t        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n391\t        Assert.IsTrue(FinalCount > InitialCount, 'Statement journal line should be created for automatic customer');\n392\t\n393\t        // [AND] Customer's last automatic date should be updated\n394\t        Customer.Find();\n395\t        Assert.AreEqual(WorkDate(), Customer.\"CDO Last Automatic Date\", 'Last Automatic Date should be updated to WorkDate');\n396\t    end;\n397\t\n398\t    // SKIP: Test requires complex setup that conflicts with internal Commit calls\n399\t    // SendPeriodStatements internally calls Commit, but without AutoRollback test data persists\n400\t    // causing \"Email Template Header already exists\" errors on repeated runs.\n401\t    // [Test]\n402\t    // procedure SendPeriodStatements_WhenReminderExistsAndFlagSet_ShouldChangeToManual()\n403\t\n404\t    #endregion\n405\t}\n406\t"}]},"parent_tool_use_id":null,"session_id":"7f3c1a92-5d84-4b16-9e07-2c8a6f0d3b51","uuid":"cd3465c2-1426-4508-9240-4e7bcea3b8a5","timestamp":"2026-08-04T22:48:49.789Z","tool_use_result":{"type":"text","file":{"filePath":"U:\\Git\\do-lethal\\Test\\Src\\AutomaticDocuments\\CDOSendCustStatementTests.Codeunit.al","content":"codeunit 68929 \"CDO Send Cust. Statement Tests\"\n{\n    Subtype = Test;\n    TestPermissions = Disabled;\n\n    var\n        Assert: Codeunit Assert;\n        LibrarySales: Codeunit \"Library - Sales\";\n        LibraryEmailTemplate: Codeunit \"CDO Library - Email Template\";\n        LibrarySetup: Codeunit \"CDO Library - Setup\";\n        LibraryStatement: Codeunit \"CDO Library - Statement\";\n\n    #region ChangeAutomaticToManual Tests\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ChangeAutomaticToManual_WhenNoLastDate_ShouldReturnFalse()\n    var\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        Result: Boolean;\n    begin\n        // [SCENARIO] ChangeAuatomaticToManual returns false when LastDate is 0D\n        // [GIVEN] A SendCustStatement record and LastDate set to 0D\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n        SendCustStatement.\"Change to manual on Reminder\" := true;\n        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := true;\n        SendCustStatement.Modify();\n\n        // [WHEN] ChangeAuatomaticToManual is called with LastDate = 0D\n        Result := SendCustStatementMgt.ChangeAuatomaticToManual('CUST001', 0D, SendCustStatement);\n\n        // [THEN] Result should be false (no change to manual)\n        Assert.IsFalse(Result, 'Should return false when LastDate is 0D');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ChangeAutomaticToManual_WhenBothFlagsAreFalse_ShouldReturnFalse()\n    var\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        Result: Boolean;\n    begin\n        // [SCENARIO] ChangeAuatomaticToManual returns false when both change flags are false\n        // [GIVEN] A SendCustStatement record with both change flags set to false\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n        SendCustStatement.\"Change to manual on Reminder\" := false;\n        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := false;\n        SendCustStatement.Modify();\n\n        // [WHEN] ChangeAuatomaticToManual is called\n        Result := SendCustStatementMgt.ChangeAuatomaticToManual('CUST001', WorkDate() - 30, SendCustStatement);\n\n        // [THEN] Result should be false\n        Assert.IsFalse(Result, 'Should return false when both change flags are false');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ChangeAutomaticToManual_WhenReminderFlagSetAndReminderExists_ShouldReturnTrue()\n    var\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        Customer: Record Customer;\n        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        LastDate: Date;\n        Result: Boolean;\n    begin\n        // [SCENARIO] ChangeAuatomaticToManual returns true when reminder flag is set and reminder entry exists after LastDate\n        // [GIVEN] A customer with a Reminder ledger entry after LastDate\n        LibrarySetup.InitializeCDOSetup();\n        LibrarySales.CreateCustomer(Customer);\n        LastDate := CalcDate('<-1M>', WorkDate());\n\n        LibrarySales.MockCustLedgerEntry(CustLedgerEntry, Customer.\"No.\");\n        CustLedgerEntry.\"Document Type\" := CustLedgerEntry.\"Document Type\"::Reminder;\n        CustLedgerEntry.\"Posting Date\" := CalcDate('<-1W>', WorkDate()); // After LastDate\n        CustLedgerEntry.Modify();\n\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n        SendCustStatement.\"Change to manual on Reminder\" := true;\n        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := false;\n        SendCustStatement.Modify();\n\n        // [WHEN] ChangeAuatomaticToManual is called\n        Result := SendCustStatementMgt.ChangeAuatomaticToManual(Customer.\"No.\", LastDate, SendCustStatement);\n\n        // [THEN] Result should be true\n        Assert.IsTrue(Result, 'Should return true when reminder entry exists after LastDate');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ChangeAutomaticToManual_WhenFinChargeFlagSetAndFinChargeExists_ShouldReturnTrue()\n    var\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        Customer: Record Customer;\n        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        LastDate: Date;\n        Result: Boolean;\n    begin\n        // [SCENARIO] ChangeAuatomaticToManual returns true when finance charge flag is set and finance charge entry exists after LastDate\n        // [GIVEN] A customer with a Finance Charge Memo ledger entry after LastDate\n        LibrarySetup.InitializeCDOSetup();\n        LibrarySales.CreateCustomer(Customer);\n        LastDate := CalcDate('<-1M>', WorkDate());\n\n        LibrarySales.MockCustLedgerEntry(CustLedgerEntry, Customer.\"No.\");\n        CustLedgerEntry.\"Document Type\" := CustLedgerEntry.\"Document Type\"::\"Finance Charge Memo\";\n        CustLedgerEntry.\"Posting Date\" := CalcDate('<-1W>', WorkDate()); // After LastDate\n        CustLedgerEntry.Modify();\n\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n        SendCustStatement.\"Change to manual on Reminder\" := false;\n        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := true;\n        SendCustStatement.Modify();\n\n        // [WHEN] ChangeAuatomaticToManual is called\n        Result := SendCustStatementMgt.ChangeAuatomaticToManual(Customer.\"No.\", LastDate, SendCustStatement);\n\n        // [THEN] Result should be true\n        Assert.IsTrue(Result, 'Should return true when finance charge entry exists after LastDate');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ChangeAutomaticToManual_WhenNoMatchingEntriesExist_ShouldReturnFalse()\n    var\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        Customer: Record Customer;\n        CustLedgerEntry: Record \"Cust. Ledger Entry\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        LastDate: Date;\n        Result: Boolean;\n    begin\n        // [SCENARIO] ChangeAuatomaticToManual returns false when flags are set but no matching entries exist\n        // [GIVEN] A customer with no Reminder or Finance Charge entries after LastDate\n        LibrarySetup.InitializeCDOSetup();\n        LibrarySales.CreateCustomer(Customer);\n        LastDate := CalcDate('<-1M>', WorkDate());\n\n        // Create an invoice entry (not reminder or finance charge)\n        LibrarySales.MockCustLedgerEntry(CustLedgerEntry, Customer.\"No.\");\n        CustLedgerEntry.\"Document Type\" := CustLedgerEntry.\"Document Type\"::Invoice;\n        CustLedgerEntry.\"Posting Date\" := CalcDate('<-1W>', WorkDate());\n        CustLedgerEntry.Modify();\n\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n        SendCustStatement.\"Change to manual on Reminder\" := true;\n        SendCustStatement.\"Change to manual on Fin.Chr.M.\" := true;\n        SendCustStatement.Modify();\n\n        // [WHEN] ChangeAuatomaticToManual is called\n        Result := SendCustStatementMgt.ChangeAuatomaticToManual(Customer.\"No.\", LastDate, SendCustStatement);\n\n        // [THEN] Result should be false\n        Assert.IsFalse(Result, 'Should return false when no matching entries exist');\n    end;\n\n    #endregion\n\n    #region CreateStatement Tests\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure CreateStatement_WithJournalHandle_WhenRecordExists_ShouldNotDuplicate()\n    var\n        StatementJournalLine: Record \"CDO Statement Journal Line\";\n        Customer: Record Customer;\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        Created: Boolean;\n        StartDate: Date;\n        EndDate: Date;\n        InitialCount: Integer;\n        FinalCount: Integer;\n    begin\n        // [SCENARIO] CreateStatement with Journal handle should not duplicate existing records\n        // [GIVEN] A statement journal line already exists for the customer/period/template\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomer(Customer);\n        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n\n        StartDate := CalcDate('<-CM>', WorkDate());\n        EndDate := CalcDate('<+CM>', WorkDate());\n\n        // Create first record\n        SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(), StartDate, EndDate, EmailTemplateHeader.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] CreateStatement is called again with same parameters\n        Created := SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(), StartDate, EndDate, EmailTemplateHeader.Code);\n\n        // [THEN] No duplicate should be created\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.AreEqual(InitialCount, FinalCount, 'Should not create duplicate journal lines');\n        Assert.IsFalse(Created, 'Created should be false for duplicate records');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure CreateStatement_WithJournalHandle_WhenPDFGenerated_ShouldInsertJournalLine()\n    var\n        Customer: Record Customer;\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        StatementJournalLine: Record \"CDO Statement Journal Line\";\n        Created: Boolean;\n        StartDate: Date;\n        EndDate: Date;\n    begin\n        // [SCENARIO] CreateStatement with Journal handle should insert journal line when PDF is generated\n        // [GIVEN] A customer with statement data\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomer(Customer);\n        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n\n        StartDate := CalcDate('<-CM>', WorkDate());\n        EndDate := CalcDate('<+CM>', WorkDate());\n\n        // [WHEN] CreateStatement is called with Journal handle (0)\n        Created := SendCustStatementMgt.CreateStatement(0, 0, Customer.\"No.\", WorkDate(), StartDate, EndDate, EmailTemplateHeader.Code);\n\n        // [THEN] A journal line should be created with PDF content\n        StatementJournalLine.SetRange(\"Customer No.\", Customer.\"No.\");\n        Assert.IsTrue(StatementJournalLine.FindLast(), 'Journal line should be created');\n        Assert.IsTrue(StatementJournalLine.HasPDF(), 'Journal line should have PDF content');\n        Assert.IsTrue(Created, 'Created should be true when PDF is generated');\n    end;\n\n    // SKIP: Test requires complex setup that conflicts with internal Commit calls\n    // CreateStatement internally calls Commit, but without AutoRollback test data persists\n    // causing conflicts on repeated runs. Needs investigation of test isolation approach.\n    // [Test]\n    // procedure CreateStatement_ShouldSetCorrectFieldValues()\n\n    #endregion\n\n    #region IsCustomerStatementReport Tests\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure IsCustomerStatementReport_WithNonCustomerTable_ShouldReturnFalse()\n    var\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        ItemRef: RecordRef;\n        Item: Record Item;\n        Result: Boolean;\n    begin\n        // [SCENARIO] IsCustomerStatementReport should return false for non-Customer tables\n        // [GIVEN] An Item record (not Customer)\n        ItemRef.GetTable(Item);\n\n        // [WHEN] IsCustomerStatementReport is called\n        Result := SendCustStatementMgt.IsCustomerStatementReport(Report::Statement, ItemRef);\n\n        // [THEN] Result should be false\n        Assert.IsFalse(Result, 'Should return false for non-Customer tables');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure IsCustomerStatementReport_WithStatementReport_ShouldReturnTrue()\n    var\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        CustomerRef: RecordRef;\n        Customer: Record Customer;\n        Result: Boolean;\n    begin\n        // [SCENARIO] IsCustomerStatementReport should return true for standard Statement report\n        // [GIVEN] A Customer record and Statement report ID\n        CustomerRef.GetTable(Customer);\n\n        // [WHEN] IsCustomerStatementReport is called with Report::Statement\n        Result := SendCustStatementMgt.IsCustomerStatementReport(Report::Statement, CustomerRef);\n\n        // [THEN] Result should be true\n        Assert.IsTrue(Result, 'Should return true for standard Statement report');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure IsCustomerStatementReport_WithStandardStatementReport_ShouldReturnTrue()\n    var\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        CustomerRef: RecordRef;\n        Customer: Record Customer;\n        Result: Boolean;\n    begin\n        // [SCENARIO] IsCustomerStatementReport should return true for Standard Statement report\n        // [GIVEN] A Customer record and Standard Statement report ID\n        CustomerRef.GetTable(Customer);\n\n        // [WHEN] IsCustomerStatementReport is called with Report::\"Standard Statement\"\n        Result := SendCustStatementMgt.IsCustomerStatementReport(Report::\"Standard Statement\", CustomerRef);\n\n        // [THEN] Result should be true\n        Assert.IsTrue(Result, 'Should return true for Standard Statement report');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure IsCustomerStatementReport_WithEmailTemplateForStatements_ShouldReturnTrue()\n    var\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        EMailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        CustomerRef: RecordRef;\n        Customer: Record Customer;\n        CustomReportID: Integer;\n        Result: Boolean;\n    begin\n        // [SCENARIO] IsCustomerStatementReport should return true for reports configured in Email Templates for C.Statement\n        // [GIVEN] An Email Template configured for C.Statement with a custom report\n        CustomReportID := 60001;\n        CustomerRef.GetTable(Customer);\n\n        EMailTemplateHeader.Init();\n        EMailTemplateHeader.Code := 'CUST-STMT-TST';\n        EMailTemplateHeader.\"Report-ID\" := CustomReportID;\n        EMailTemplateHeader.\"Report Selection Usage\" := EMailTemplateHeader.\"Report Selection Usage\"::\"C.Statement\";\n        EMailTemplateHeader.Insert();\n\n        // [WHEN] IsCustomerStatementReport is called with the custom report ID\n        Result := SendCustStatementMgt.IsCustomerStatementReport(CustomReportID, CustomerRef);\n\n        // [THEN] Result should be true\n        Assert.IsTrue(Result, 'Should return true for reports configured in Email Templates for C.Statement');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure IsCustomerStatementReport_WithUnrelatedReport_ShouldReturnFalse()\n    var\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        CustomerRef: RecordRef;\n        Customer: Record Customer;\n        UnrelatedReportID: Integer;\n        Result: Boolean;\n    begin\n        // [SCENARIO] IsCustomerStatementReport should return false for unrelated reports\n        // [GIVEN] A Customer record and an unrelated report ID\n        UnrelatedReportID := 88888;\n        CustomerRef.GetTable(Customer);\n\n        // [WHEN] IsCustomerStatementReport is called with an unrelated report ID\n        Result := SendCustStatementMgt.IsCustomerStatementReport(UnrelatedReportID, CustomerRef);\n\n        // [THEN] Result should be false\n        Assert.IsFalse(Result, 'Should return false for unrelated reports');\n    end;\n\n    #endregion\n\n    #region SendPeriodStatements Integration Tests\n\n    [Test]\n    procedure SendPeriodStatements_WhenCustomerSetToAutomatic_ShouldProcessCustomer()\n    var\n        Customer: Record Customer;\n        SendCustStatement: Record \"CDO Send Customer Statement\";\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n        SendCustStatementMgt: Codeunit \"CDO Send Cust. Statement Mgt.\";\n        InitialCount: Integer;\n        FinalCount: Integer;\n    begin\n        // [SCENARIO] SendPeriodStatements should process customers with Automatic statement setting\n        // [GIVEN] A customer with automatic statement and a valid setup\n        LibrarySetup.InitializeCDOSetup();\n        LibraryStatement.ClearStatementJournalLines();\n        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, 1000, CalcDate('<-2M>', WorkDate()));\n        LibraryStatement.CreateSendCustomerStatementSetup(SendCustStatement, EmailTemplateHeader, SendCustStatement.\"Send statement if\"::Balance);\n        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustStatement.Code);\n\n        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n\n        // [WHEN] SendPeriodStatements is called\n        SendCustStatementMgt.SendPeriodStatements();\n\n        // [THEN] Statement should be created for the customer\n        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n        Assert.IsTrue(FinalCount > InitialCount, 'Statement journal line should be created for automatic customer');\n\n        // [AND] Customer's last automatic date should be updated\n        Customer.Find();\n        Assert.AreEqual(WorkDate(), Customer.\"CDO Last Automatic Date\", 'Last Automatic Date should be updated to WorkDate');\n    end;\n\n    // SKIP: Test requires complex setup that conflicts with internal Commit calls\n    // SendPeriodStatements internally calls Commit, but without AutoRollback test data persists\n    // causing \"Email Template Header already exists\" errors on repeated runs.\n    // [Test]\n    // procedure SendPeriodStatements_WhenReminderExistsAndFlagSet_ShouldChangeToManual()\n\n    #endregion\n}\n","numLines":406,"startLine":1,"totalLines":406}}}
