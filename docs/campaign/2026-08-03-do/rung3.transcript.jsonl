erEntry.Init();\n        BankAccountLedgerEntry.\"Bank Account No.\" := CopyStr(BankAccount.\"Bank Account No.\", 1, MaxStrLen(BankAccountLedgerEntry.\"Bank Account No.\"));\n        BankAccountLedgerEntry.\"Posting Date\" := BankAccountLedgerPostingDate;\n        BankAccountLedgerEntry.Insert();\n    end;\n\n    internal procedure CreateStetementLedgerEntries(CustomerLedgerPostingDate: Date; var Customer: Record Customer)\n    var\n        BankAccount: Record \"Customer Bank Account\";\n        CustomerLedgerEntry: Record \"Cust. Ledger Entry\";\n    begin\n        LibrarySales.CreateCustomer(Customer);\n        LibrarySales.CreateCustomerBankAccount(BankAccount, Customer.\"No.\");\n        BankAccount.\"Bank Account No.\" := CopyStr(Any.AlphabeticText(30), 1, MaxStrLen(BankAccount.\"Bank Account No.\"));\n        BankAccount.Modify();\n\n        LibrarySales.MockCustLedgerEntryWithAmount(CustomerLedgerEntry, Customer.\"No.\");\n        CustomerLedgerEntry.\"Posting Date\" := CustomerLedgerPostingDate;\n        CustomerLedgerEntry.\"Bal. Account Type\" := CustomerLedgerEntry.\"Bal. Account Type\"::\"Bank Account\";\n        CustomerLedgerEntry.\"Bal. Account No.\" := CopyStr(BankAccount.\"Bank Account No.\", 1, MaxStrLen(CustomerLedgerEntry.\"Bal. Account No.\"));\n        CustomerLedgerEntry.Open := true;\n        CustomerLedgerEntry.Modify();\n    end;\n\n    internal procedure ClearStatementJournalLines()\n    var\n        StatementJournalLine: Record \"CDO Statement Journal Line\";\n    begin\n        StatementJournalLine.Reset();\n        StatementJournalLine.DeleteAll();\n    end;\n\n    internal procedure MockStatementJournalLine(var StatementJournalLine: Record \"CDO Statement Journal Line\")\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n    begin\n        LibrarySetup.InitializeCDOSetup();\n        EnsureStatementEmailTemplate(EmailTemplateHeader);\n\n        StatementJournalLine.Init();\n        StatementJournalLine.\"Customer No.\" := 'CUST001';\n        StatementJournalLine.\"Start Date\" := DMY2DATE(1, 1, 2023);\n        StatementJournalLine.\"End Date\" := DMY2DATE(31, 1, 2023);\n        StatementJournalLine.\"E-Mail Template Code\" := EmailTemplateHeader.Code;\n        StatementJournalLine.Insert();\n    end;\n\n    internal procedure MockStatementJournalLine(var StatementJournalLine: Record \"CDO Statement Journal Line\"; var Customer: Record Customer)\n    var\n        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n    begin\n        LibrarySetup.InitializeCDOSetup();\n        EnsureStatementEmailTemplate(EmailTemplateHeader);\n\n        StatementJournalLine.Init();\n        StatementJournalLine.\"Customer No.\" := Customer.\"No.\";\n        StatementJournalLine.\"Start Date\" := CalcDate('<-CM>', WorkDate());\n        StatementJournalLine.\"End Date\" := CalcDate('<+CM>', WorkDate());\n        StatementJournalLine.\"E-Mail Template Code\" := EmailTemplateHeader.Code;\n        StatementJournalLine.Insert();\n    end;\n\n\n    internal procedure MockStatementJournalLine(EmailTemplateCode: Code[20]; var StatementJournalLine: Record \"CDO Statement Journal Line\"; var Customer: Record Customer)\n    begin\n        LibrarySetup.InitializeCDOSetup();\n\n        StatementJournalLine.Init();\n        StatementJournalLine.\"Customer No.\" := Customer.\"No.\";\n        StatementJournalLine.\"Start Date\" := CalcDate('<-CM>', WorkDate());\n        StatementJournalLine.\"End Date\" := CalcDate('<+CM>', WorkDate());\n        StatementJournalLine.\"E-Mail Template Code\" := EmailTemplateCode;\n        StatementJournalLine.Insert();\n    end;\n\n    internal procedure CreateStatementEmailTemplate(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\")\n    begin\n        EmailTemplateHeader.Init();\n        EmailTemplateHeader.Code := CopyStr(Any.AlphabeticText(20), 1, MaxStrLen(EmailTemplateHeader.Code));\n        EmailTemplateHeader.Insert();\n    end;\n\n    internal procedure MockStatementForCustomer(var Customer: Record Customer)\n    var\n        CustomerLedgerEntry: Record \"Cust. Ledger Entry\";\n    begin\n        LibrarySetup.InitializeCDOSetup();\n        LibrarySales.CreateCustomer(Customer);\n        LibrarySales.MockCustLedgerEntry(CustomerLedgerEntry, Customer.\"No.\");\n        LibrarySales.MockDetailedCustLedgEntry(CustomerLedgerEntry);\n    end;\n\n    internal procedure MockStatementForCustomerWithAmount(var Customer: Record Customer; Amount: Decimal)\n    var\n        CustomerLedgerEntry: Record \"Cust. Ledger Entry\";\n        DetailedCustLedgEntry: Record \"Detailed Cust. Ledg. Entry\";\n    begin\n        LibrarySetup.InitializeCDOSetup();\n        LibrarySales.CreateCustomer(Customer);\n        LibrarySales.MockCustLedgerEntry(CustomerLedgerEntry, Customer.\"No.\");\n        LibrarySales.MockDetailedCustLedgEntry(CustomerLedgerEntry);\n\n        DetailedCustLedgEntry.Reset();\n        DetailedCustLedgEntry.SetRange(\"Cust. Ledger Entry No.\", CustomerLedgerEntry.\"Entry No.\");\n        if DetailedCustLedgEntry.FindFirst() then begin\n            DetailedCustLedgEntry.Amount := Amount;\n            DetailedCustLedgEntry.\"Amount (LCY)\" := Amount;\n            DetailedCustLedgEntry.Modify(true);\n        end;\n    end;\n\n    internal procedure MockStatementForCustomerWithAmountAndPostingDate(var Customer: Record Customer; Amount: Decimal; PostingDate: Date)\n    var\n        CustomerLedgerEntry: Record \"Cust. Ledger Entry\";\n        DetailedCustLedgEntry: Record \"Detailed Cust. Ledg. Entry\";\n    begin\n        LibrarySetup.InitializeCDOSetup();\n        LibrarySales.CreateCustomer(Customer);\n        LibrarySales.MockCustLedgerEntry(CustomerLedgerEntry, Customer.\"No.\");\n        LibrarySales.MockDetailedCustLedgEntry(CustomerLedgerEntry);\n        CustomerLedgerEntry.\"Posting Date\" := PostingDate;\n        CustomerLedgerEntry.Modify(true);\n\n        DetailedCustLedgEntry.Reset();\n        DetailedCustLedgEntry.SetRange(\"Cust. Ledger Entry No.\", CustomerLedgerEntry.\"Entry No.\");\n        if DetailedCustLedgEntry.FindFirst() then begin\n            DetailedCustLedgEntry.Amount := Amount;\n            DetailedCustLedgEntry.\"Amount (LCY)\" := Amount;\n            DetailedCustLedgEntry.\"Posting Date\" := PostingDate;\n            DetailedCustLedgEntry.\"Initial Entry Due Date\" := CalcDate('<+CM>', PostingDate);\n            DetailedCustLedgEntry.Modify(true);\n        end;\n    end;\n\n    internal procedure CreateCustomerWithZeroBalance(var Customer: Record Customer)\n    begin\n        // Use MockStatementForCustomer to create proper setup for PDF generation, \n        // then clear the detailed entries to achieve zero balance\n        MockStatementForCustomer(Customer);\n\n        // Clear the detailed entries to create zero balance while keeping the structure\n        // that allows PDF generation to work\n        ClearCustomerDetailedEntries(Customer.\"No.\");\n    end;\n\n    local procedure ClearCustomerDetailedEntries(CustomerNo: Code[20])\n    var\n        DetailedCustLedgEntry: Record \"Detailed Cust. Ledg. Entry\";\n    begin\n        DetailedCustLedgEntry.SetRange(\"Customer No.\", CustomerNo);\n        DetailedCustLedgEntry.DeleteAll();\n    end;\n\n    internal procedure CreateSendCustomerStatementSetup(var SendCustomerStatement: Record \"CDO Send Customer Statement\"; var EmailTemplateHeader: Record \"CDO E-Mail Template Header\"; SendStatementIf: Option)\n    var\n        LibraryEmailTemplate: Codeunit \"CDO Library - Email Template\";\n    begin\n        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n\n        SendCustomerStatement.Init();\n        SendCustomerStatement.Code := CopyStr(Any.AlphabeticText(10), 1, MaxStrLen(SendCustomerStatement.Code));\n        SendCustomerStatement.\"Send statement if\" := SendStatementIf;\n        SendCustomerStatement.\"E-Mail Template Code\" := EmailTemplateHeader.Code;\n        SendCustomerStatement.Output := SendCustomerStatement.Output::Journal;\n        Evaluate(SendCustomerStatement.\"Period Date Formula\", '1M');\n        SendCustomerStatement.Insert();\n    end;\n\n    internal procedure SetupCustomerForAutomaticStatements(var Customer: Record Customer; SendStatementCode: Code[10])\n    begin\n        Customer.\"CDO Automatic statement\" := Customer.\"CDO Automatic statement\"::Automatic;\n        Customer.\"CDO Send Statement Code\" := SendStatementCode;\n        Customer.\"CDO Last Automatic Date\" := CalcDate('<-2M>', WorkDate()); // Ensure it's old enough\n        Customer.Modify();\n    end;\n\n    internal procedure GetStatementJournalLineCount(CustomerNo: Code[20]): Integer\n    var\n        StatementJournalLine: Record \"CDO Statement Journal Line\";\n    begin\n        StatementJournalLine.SetRange(\"Customer No.\", CustomerNo);\n        exit(StatementJournalLine.Count);\n    end;\n\n    internal procedure GetStatementEmailTemplateCode(): Code[20]\n    begin\n        exit(StatementEmailTemplateCode);\n    end;\n\n    local procedure EnsureStatementEmailTemplate(var EmailTemplateHeader: Record \"CDO E-Mail Template Header\")\n    begin\n        if StatementEmailTemplateCode <> '' then begin\n            if EmailTemplateHeader.Get(StatementEmailTemplateCode) then\n                exit;\n        end;\n\n        LibraryEmailTemplate.MockStatementEmailTemplate(EmailTemplateHeader);\n        StatementEmailTemplateCode := EmailTemplateHeader.Code;\n    end;\n}","numLines":227,"startLine":1,"totalLines":227}}}
