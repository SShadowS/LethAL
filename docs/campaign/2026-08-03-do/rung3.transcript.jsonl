 := DMY2Date(15, 12, 2023); // 15th December 2023\n334\t\n335\t        // [When] Call the NextSendingDate method\n336\t        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n337\t\n338\t        // [Then] Verify that the result matches the expected date\n339\t        ExpectedDate := DMY2Date(15, 1, 2024); // 15th January 2024\n340\t        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n341\t    end;\n342\t\n343\t    [Test]\n344\t    [TransactionModel(TransactionModel::AutoRollback)]\n345\t    procedure NextSendingDate_WhenStartDayIsNotSet_ShouldReturnNextSendingDateBasedOnInterval()\n346\t    var\n347\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n348\t        CurrDate: Date;\n349\t        Result: Date;\n350\t        ExpectedDate: Date;\n351\t    begin\n352\t        // [Scenario] NextSendingDate returns the next sending date based on interval when start day is not set\n353\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n354\t        AutomaticPeriodStatement.Init();\n355\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n356\t        CurrDate := DMY2Date(10, 1, 2023); // 10th January 2023\n357\t\n358\t        // [When] Call the NextSendingDate method\n359\t        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n360\t\n361\t        // [Then] Verify that the result matches the expected date\n362\t        ExpectedDate := DMY2Date(10, 2, 2023); // 10th February 2023\n363\t        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n364\t    end;\n365\t\n366\t    [Test]\n367\t    [TransactionModel(TransactionModel::AutoRollback)]\n368\t    procedure NextSendingDate_WhenWeekdayIsSet_ShouldReturnNextSendingDateOnWeekday()\n369\t    var\n370\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n371\t        CurrDate: Date;\n372\t        Result: Date;\n373\t        ExpectedDate: Date;\n374\t    begin\n375\t        // [Scenario] NextSendingDate returns the next sending date on the specified weekday\n376\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n377\t        AutomaticPeriodStatement.Init();\n378\t        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n379\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1W');\n380\t        CurrDate := DMY2Date(10, 1, 2023); // 10th January 2023 (Tuesday)\n381\t\n382\t        // [When] Call the NextSendingDate method\n383\t        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n384\t\n385\t        // [Then] Verify that the result matches the expected date\n386\t        ExpectedDate := DMY2Date(16, 1, 2023); // 16th January 2023 (Next Monday)\n387\t        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n388\t    end;\n389\t\n390\t    [Test]\n391\t    [TransactionModel(TransactionModel::AutoRollback)]\n392\t    procedure NextSendingDate_WhenWeekdayIsSetToTheSameDay_ShouldReturnNextSendingDateOnWeekday()\n393\t    var\n394\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n395\t        CurrDate: Date;\n396\t        Result: Date;\n397\t        ExpectedDate: Date;\n398\t    begin\n399\t        // [Scenario] NextSendingDate returns the next sending date on the specified weekday\n400\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n401\t        AutomaticPeriodStatement.Init();\n402\t        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n403\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1W');\n404\t        CurrDate := DMY2Date(16, 1, 2023); // 16th January 2023 (Monday)\n405\t\n406\t        // [When] Call the NextSendingDate method\n407\t        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n408\t\n409\t        // [Then] Verify that the result matches the expected date\n410\t        ExpectedDate := DMY2Date(23, 1, 2023); // 23rd January 2023 (Next Monday)\n411\t        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n412\t    end;\n413\t\n414\t    [Test]\n415\t    [TransactionModel(TransactionModel::AutoRollback)]\n416\t    procedure NextSendingDate_WhenWeekdayIsSet_ShouldNotReturnLastMonthsDate()\n417\t    var\n418\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n419\t        CurrDate: Date;\n420\t        Result: Date;\n421\t        ExpectedDate: Date;\n422\t    begin\n423\t        // [Scenario] NextSendingDate does not return the last month's date when weekday is set\n424\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n425\t        AutomaticPeriodStatement.Init();\n426\t        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n427\t        AutomaticPeriodStatement.\"Sending interval start day\" := 3;\n428\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n429\t        CurrDate := DMY2Date(31, 3, 2025); // 31st March 2025 (Tuesday)\n430\t\n431\t        // [When] Call the NextSendingDate method\n432\t        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n433\t\n434\t        // [Then] Verify that the result matches the expected date\n435\t        ExpectedDate := DMY2Date(7, 4, 2025); // 7th April 2025 (Next Monday)\n436\t        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n437\t    end;\n438\t\n439\t    [Test]\n440\t    [TransactionModel(TransactionModel::AutoRollback)]\n441\t    procedure NextSendingDate_WhenWeekdayIsSetAndLargeDifferenceBetweenTargetDate_ShouldNotReturnLastMonthsDate()\n442\t    var\n443\t        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n444\t        CurrDate: Date;\n445\t        Result: Date;\n446\t        ExpectedDate: Date;\n447\t    begin\n448\t        // [Scenario] NextSendingDate does not return the last month's date when weekday is set\n449\t        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n450\t        AutomaticPeriodStatement.Init();\n451\t        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n452\t        AutomaticPeriodStatement.\"Sending interval start day\" := 1;\n453\t        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n454\t        CurrDate := DMY2Date(31, 3, 2025); // 31st March 2025 (Tuesday)\n455\t\n456\t        // [When] Call the NextSendingDate method\n457\t        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n458\t\n459\t        // [Then] Verify that the result matches the expected date\n460\t        ExpectedDate := DMY2Date(7, 4, 2025); // 7th April 2025 (Next Monday)\n461\t        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n462\t    end;\n463\t}\n464\t"}]},"parent_tool_use_id":null,"session_id":"7f3c1a92-5d84-4b16-9e07-2c8a6f0d3b51","uuid":"0f50cf17-c399-4272-b055-16bed0148b9d","timestamp":"2026-08-04T22:48:54.437Z","tool_use_result":{"type":"text","file":{"filePath":"U:\\Git\\do-lethal\\Test\\Src\\AutomaticDocuments\\CDOAutPeriodStatTests.Codeunit.al","content":"codeunit 68857 \"CDO Aut. Period Stat. Tests\"\n{\n    Subtype = Test;\n    TestPermissions = Disabled;\n\n    var\n        Assert: Codeunit Assert;\n        LibraryStatement: Codeunit \"CDO Library - Statement\";\n\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetDescription_WhenWeekdayAndStartDay_ShouldReturnCorrectDescription()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        ExpectedDescriptionLbl: Label 'Send Statement on the first Monday on or after the 1 day of the month, every 1M if customer has Balance, Period: ', Locked = true;\n        Result: Text;\n    begin\n        // [Scenario] GetDescription returns correct description when both weekday and start day are set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n        AutomaticPeriodStatement.\"Sending interval start day\" := 1;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        AutomaticPeriodStatement.\"Send statement if\" := AutomaticPeriodStatement.\"Send statement if\"::Balance;\n\n        // [When] Call the GetDescription method to get the description based on the set fields\n        Result := AutomaticPeriodStatement.GetDescription();\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(ExpectedDescriptionLbl, Result, 'The description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetDescription_WhenWeekdayOnly_ShouldReturnCorrectDescription()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        ExpectedDescriptionLbl: Label 'Send Statement on Monday every 1M if customer has Balance, Period: ', Locked = true;\n        Result: Text;\n    begin\n        // [Scenario] GetDescription returns correct description when only weekday is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        AutomaticPeriodStatement.\"Send statement if\" := AutomaticPeriodStatement.\"Send statement if\"::Balance;\n\n        // [When] Call the GetDescription method to get the description based on the set fields\n        Result := AutomaticPeriodStatement.GetDescription();\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(ExpectedDescriptionLbl, Result, 'The description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetDescription_WhenStartDayOnly_ShouldReturnCorrectDescription()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        ExpectedDescriptionLbl: Label 'Send Statement on day 1 every 1M if customer has Balance, Period: ', Locked = true;\n        Result: Text;\n    begin\n        // [Scenario] GetDescription returns correct description when only start day is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval start day\" := 1;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        AutomaticPeriodStatement.\"Send statement if\" := AutomaticPeriodStatement.\"Send statement if\"::Balance;\n\n        // [When] Call the GetDescription method to get the description based on the set fields\n        Result := AutomaticPeriodStatement.GetDescription();\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(ExpectedDescriptionLbl, Result, 'The description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetDescription_WhenNoWeekdayAndStartDay_ShouldReturnCorrectDescription()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        ExpectedDescriptionLbl: Label 'Send Statement every 1M if customer has Balance, Period: ', Locked = true;\n        Result: Text;\n    begin\n        // [Scenario] GetDescription returns correct description when neither weekday nor start day is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        AutomaticPeriodStatement.\"Send statement if\" := AutomaticPeriodStatement.\"Send statement if\"::Balance;\n\n        // [When] Call the GetDescription method to get the description based on the set fields\n        Result := AutomaticPeriodStatement.GetDescription();\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(ExpectedDescriptionLbl, Result, 'The description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDescription_WhenDateFormulaAndSendingDateIsZero_ShouldReturnPeriodDateFormula()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Result: Text;\n        ExpectedDescriptionLbl: Label 'Period: %1', Locked = true;\n    begin\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"Date formula\";\n        Evaluate(AutomaticPeriodStatement.\"Period Date Formula\", '1M');\n\n        // [When] Call the GetPeriodDescription method with SendingDate as 0D\n        Result := AutomaticPeriodStatement.GetPeriodDescription(0D);\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(StrSubstNo(ExpectedDescriptionLbl, AutomaticPeriodStatement.\"Period Date Formula\"), Result, 'The period description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDescription_WhenDateFormulaAndSendingDateIsNotZero_ShouldReturnPeriodStartAndEndDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Result: Text;\n        ExpectedDescriptionLbl: Label 'Period: %1 - %2', Locked = true;\n        StartDate: Date;\n        EndDate: Date;\n    begin\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"Date formula\";\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Date formula\";\n        Evaluate(AutomaticPeriodStatement.\"Period Date Formula\", '1M');\n\n        // [When] Call the GetPeriodDescription method with a valid SendingDate\n        StartDate := 20221201D;\n        EndDate := 20221231D;\n        Result := AutomaticPeriodStatement.GetPeriodDescription(20230101D);\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(StrSubstNo(ExpectedDescriptionLbl, StartDate, EndDate), Result, 'The period description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDescription_WhenFirstOpenEntryDate_ShouldReturnPeriodStartAndEndDateType()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Result: Text;\n        ExpectedDescriptionLbl: Label 'Period: %1 until %2', Locked = true;\n    begin\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"First open entry Date\";\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Last open entry date\";\n\n        // [When] Call the GetPeriodDescription method\n        Result := AutomaticPeriodStatement.GetPeriodDescription(20230101D);\n\n        // [Then] Verify that the result matches the expected description\n        Assert.AreEqual(StrSubstNo(ExpectedDescriptionLbl, AutomaticPeriodStatement.\"Period Start Date Type\", AutomaticPeriodStatement.\"Period End Date Type\"), Result, 'The period description does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDates_WhenSendingDateIsZero_ShouldReturnZeroDates()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        StartDate: Date;\n        EndDate: Date;\n        SendingDate: Date;\n    begin\n        // [Scenario] SendingDate is zero\n        // [Given] SendingDate is 0D\n        SendingDate := 0D;\n        // [When] GetPeriodDates is called\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, SendingDate, '');\n        // [Then] StartDate and EndDate should be 0D\n        Assert.AreEqual(StartDate, 0D, 'StartDate should be 0D');\n        Assert.AreEqual(EndDate, 0D, 'EndDate should be 0D');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDates_WhenPeriodEndDateTypeIsDateFormula_ShouldReturnCorrectDates()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        StartDate: Date;\n        EndDate: Date;\n        SendingDate: Date;\n    begin\n        // [Scenario] Period End Date Type is \"Date formula\"\n        // [Given] SendingDate is 01/01/2023 and Period End Date Type is \"Date formula\"\n        SendingDate := DMY2Date(1, 1, 2023);\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Date formula\";\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"Date formula\";\n        Evaluate(AutomaticPeriodStatement.\"Period Date Formula\", '1M');\n        // [When] GetPeriodDates is called\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, SendingDate, '');\n        // [Then] StartDate should be 01/12/2022 and EndDate should be 31/12/2022\n        Assert.AreEqual(StartDate, DMY2Date(1, 12, 2022), 'StartDate should be 01/12/2022');\n        Assert.AreEqual(EndDate, DMY2Date(31, 12, 2022), 'EndDate should be 31/12/2022');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDates_WhenPeriodEndDateTypeIsLastBankPostingDate_ShouldReturnLastBankPostingDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Customer: Record Customer;\n        StartDate: Date;\n        EndDate: Date;\n        SendingDate: Date;\n    begin\n        // [Scenario] Period End Date Type is \"Last bank posting date\"\n        // [Given] SendingDate is 01/01/2023 and Period End Date Type is \"Last bank posting date\"\n        LibraryStatement.CreateStetementLedgerEntries(DMY2Date(31, 12, 2022), DMY2Date(31, 12, 2022), Customer);\n\n        SendingDate := DMY2Date(1, 1, 2023);\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"First open entry Date\";\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Last bank posting date\";\n        // [When] GetPeriodDates is called\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, SendingDate, Customer.\"No.\");\n        // [Then] EndDate should be the last bank posting date (31/12/2022)\n        Assert.AreEqual(DMY2Date(31, 12, 2022), EndDate, 'EndDate should be the last bank posting date');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDates_WhenPeriodEndDateTypeIsLastEntryDate_ShouldReturnLastEntryDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Customer: Record Customer;\n        StartDate: Date;\n        EndDate: Date;\n        SendingDate: Date;\n    begin\n        // [Scenario] Period End Date Type is \"Last entry date\"\n        // [Given] SendingDate is 01/01/2023 and Period End Date Type is \"Last entry date\"\n        LibraryStatement.CreateStetementLedgerEntries(DMY2DATE(31, 12, 2022), Customer);\n        SendingDate := DMY2Date(1, 1, 2023);\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"First open entry Date\";\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Last entry date\";\n        // [When] GetPeriodDates is called\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, SendingDate, Customer.\"No.\");\n        // [Then] EndDate should be the last entry date (31/12/2022)\n        Assert.AreEqual(EndDate, DMY2Date(31, 12, 2022), 'EndDate should be the last entry date');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDates_WhenPeriodEndDateTypeIsLastOpenEntryDate_ShouldReturnLastOpenEntryDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Customer: Record Customer;\n        StartDate: Date;\n        EndDate: Date;\n        SendingDate: Date;\n    begin\n        // [Scenario] Period End Date Type is \"Last open entry date\"\n        // [Given] SendingDate is 01/01/2023 and Period End Date Type is \"Last open entry date\"\n        LibraryStatement.CreateStetementLedgerEntries(DMY2DATE(31, 12, 2022), Customer);\n\n        SendingDate := DMY2Date(1, 1, 2023);\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"First open entry Date\";\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Last open entry date\";\n        // [When] GetPeriodDates is called\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, SendingDate, Customer.\"No.\");\n        // [Then] EndDate should be the last open entry date (31/12/2022)\n        Assert.AreEqual(EndDate, DMY2Date(31, 12, 2022), 'EndDate should be the last open entry date');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure GetPeriodDates_WhenPeriodStartDateTypeIsFirstOpenEntryDate_ShouldReturnFirstOpenEntryDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        Customer: Record Customer;\n        StartDate: Date;\n        EndDate: Date;\n        SendingDate: Date;\n    begin\n        // [Scenario] Period Start Date Type is \"First open entry Date\"\n        // [Given] SendingDate is 01/01/2023 and Period Start Date Type is \"First open entry Date\"\n        LibraryStatement.CreateStetementLedgerEntries(DMY2Date(31, 12, 2022), Customer);\n        SendingDate := DMY2Date(1, 1, 2023);\n        AutomaticPeriodStatement.\"Period End Date Type\" := AutomaticPeriodStatement.\"Period End Date Type\"::\"Last open entry date\";\n        AutomaticPeriodStatement.\"Period Start Date Type\" := AutomaticPeriodStatement.\"Period Start Date Type\"::\"First open entry Date\";\n        // [When] GetPeriodDates is called\n        AutomaticPeriodStatement.GetPeriodDates(StartDate, EndDate, SendingDate, Customer.\"No.\");\n        // [Then] StartDate should be the first open entry date (01/01/2022)\n        Assert.AreEqual(DMY2Date(31, 12, 2022), StartDate, 'StartDate should be the first open entry date');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenStartDayIsSet_ShouldReturnNextSendingDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate returns the next sending date when start day is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval start day\" := 15;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        CurrDate := DMY2Date(10, 1, 2023); // 10th January 2023\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(15, 1, 2023); // 15th January 2023\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenStartDayIsSetToTheSameDay_ShouldReturnNextSendingDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate returns the next sending date when start day is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval start day\" := 15;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        CurrDate := DMY2Date(15, 12, 2023); // 15th December 2023\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(15, 1, 2024); // 15th January 2024\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenStartDayIsNotSet_ShouldReturnNextSendingDateBasedOnInterval()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate returns the next sending date based on interval when start day is not set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        CurrDate := DMY2Date(10, 1, 2023); // 10th January 2023\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(10, 2, 2023); // 10th February 2023\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenWeekdayIsSet_ShouldReturnNextSendingDateOnWeekday()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate returns the next sending date on the specified weekday\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1W');\n        CurrDate := DMY2Date(10, 1, 2023); // 10th January 2023 (Tuesday)\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(16, 1, 2023); // 16th January 2023 (Next Monday)\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenWeekdayIsSetToTheSameDay_ShouldReturnNextSendingDateOnWeekday()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate returns the next sending date on the specified weekday\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1W');\n        CurrDate := DMY2Date(16, 1, 2023); // 16th January 2023 (Monday)\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(23, 1, 2023); // 23rd January 2023 (Next Monday)\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenWeekdayIsSet_ShouldNotReturnLastMonthsDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate does not return the last month's date when weekday is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n        AutomaticPeriodStatement.\"Sending interval start day\" := 3;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        CurrDate := DMY2Date(31, 3, 2025); // 31st March 2025 (Tuesday)\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(7, 4, 2025); // 7th April 2025 (Next Monday)\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure NextSendingDate_WhenWeekdayIsSetAndLargeDifferenceBetweenTargetDate_ShouldNotReturnLastMonthsDate()\n    var\n        AutomaticPeriodStatement: Record \"CDO Automatic Period Statement\";\n        CurrDate: Date;\n        Result: Date;\n        ExpectedDate: Date;\n    begin\n        // [Scenario] NextSendingDate does not return the last month's date when weekday is set\n        // [Given] Initialize the AutomaticPeriodStatement record and set the necessary fields\n        AutomaticPeriodStatement.Init();\n        AutomaticPeriodStatement.\"Sending interval Weekday\" := AutomaticPeriodStatement.\"Sending interval Weekday\"::Monday;\n        AutomaticPeriodStatement.\"Sending interval start day\" := 1;\n        Evaluate(AutomaticPeriodStatement.\"Sending interval\", '1M');\n        CurrDate := DMY2Date(31, 3, 2025); // 31st March 2025 (Tuesday)\n\n        // [When] Call the NextSendingDate method\n        Result := AutomaticPeriodStatement.NextSendingDate(CurrDate);\n\n        // [Then] Verify that the result matches the expected date\n        ExpectedDate := DMY2Date(7, 4, 2025); // 7th April 2025 (Next Monday)\n        Assert.AreEqual(ExpectedDate, Result, 'The next sending date does not match the expected value.');\n    end;\n}\n","numLines":464,"startLine":1,"totalLines":464}}}
