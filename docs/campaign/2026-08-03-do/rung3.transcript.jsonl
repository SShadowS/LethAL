{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xc5gcW3SYi7RJ67VMPee1C","type":"tool_result","content":"    // ============================================================================\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure SetReportSelectionUsage_WhenCalledWithValue_ShouldSetGlobalState()\n    var\n        ReportSelection: Record \"Report Selections\";\n        SalesInvoiceHeader: Record \"Sales Invoice Header\";\n        CDOEMailHandler: Codeunit \"CDO E-Mail Handler\";\n        RecRef: RecordRef;\n        ActualUsage: Integer;\n        ExpectedUsage: Integer;\n    begin\n        // [SCENARIO] When SetReportSelectionUsage is called with a value, GetReportSelectionFromTable should return that value instead of calculating it\n\n        // [GIVEN] A CDO E-Mail Handler instance with a custom report selection usage set\n        ExpectedUsage := ReportSelection.Usage::\"S.Quote\".AsInteger();\n        CDOEMailHandler.SetReportSelectionUsage(ExpectedUsage);\n\n        // [GIVEN] A Sales Invoice Header record (which normally maps to S.Invoice usage)\n        SalesInvoiceHeader.Init();\n        SalesInvoiceHeader.\"No.\" := 'TEST-INV-001';\n        RecRef.GetTable(SalesInvoiceHeader);\n\n        // [WHEN] GetReportSelectionFromTable is called\n        // Note: We cannot directly test the internal state, but we verify the behavior\n        // by checking that ClearReportSelectionUsage restores default behavior\n\n        // [THEN] The handler should use the overridden usage value\n        // This test verifies the state was set by clearing and checking the table mapping returns\n        CDOEMailHandler.ClearReportSelectionUsage();\n        ActualUsage := CDOEMailHandler.GetReportSelectionFromTable(RecRef);\n\n        // Sales Invoice Header should map to S.Invoice (not S.Quote which was set)\n        Assert.AreEqual(ReportSelection.Usage::\"S.Invoice\".AsInteger(), ActualUsage, 'After clear, should return default mapping');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ClearReportSelectionUsage_WhenCalled_ShouldResetToDefaultBehavior()\n    var\n        ReportSelection: Record \"Report Selections\";\n        SalesHeader: Record \"Sales Header\";\n        CDOEMailHandler: Codeunit \"CDO E-Mail Handler\";\n        RecRef: RecordRef;\n        ActualUsage: Integer;","is_error":false}]},"parent_tool_use_id":null,"session_id":"7f3c1a92-5d84-4b16-9e07-2c8a6f0d3b51","uuid":"929545cc-dcc5-4509-8994-5ea7397b1e64","timestamp":"2026-08-04T22:52:50.434Z","tool_use_result":{"stdout":"    // ============================================================================\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure SetReportSelectionUsage_WhenCalledWithValue_ShouldSetGlobalState()\n    var\n        ReportSelection: Record \"Report Selections\";\n        SalesInvoiceHeader: Record \"Sales Invoice Header\";\n        CDOEMailHandler: Codeunit \"CDO E-Mail Handler\";\n        RecRef: RecordRef;\n        ActualUsage: Integer;\n        ExpectedUsage: Integer;\n    begin\n        // [SCENARIO] When SetReportSelectionUsage is called with a value, GetReportSelectionFromTable should return that value instead of calculating it\n\n        // [GIVEN] A CDO E-Mail Handler instance with a custom report selection usage set\n        ExpectedUsage := ReportSelection.Usage::\"S.Quote\".AsInteger();\n        CDOEMailHandler.SetReportSelectionUsage(ExpectedUsage);\n\n        // [GIVEN] A Sales Invoice Header record (which normally maps to S.Invoice usage)\n        SalesInvoiceHeader.Init();\n        SalesInvoiceHeader.\"No.\" := 'TEST-INV-001';\n        RecRef.GetTable(SalesInvoiceHeader);\n\n        // [WHEN] GetReportSelectionFromTable is called\n        // Note: We cannot directly test the internal state, but we verify the behavior\n        // by checking that ClearReportSelectionUsage restores default behavior\n\n        // [THEN] The handler should use the overridden usage value\n        // This test verifies the state was set by clearing and checking the table mapping returns\n        CDOEMailHandler.ClearReportSelectionUsage();\n        ActualUsage := CDOEMailHandler.GetReportSelectionFromTable(RecRef);\n\n        // Sales Invoice Header should map to S.Invoice (not S.Quote which was set)\n        Assert.AreEqual(ReportSelection.Usage::\"S.Invoice\".AsInteger(), ActualUsage, 'After clear, should return default mapping');\n    end;\n\n    [Test]\n    [TransactionModel(TransactionModel::AutoRollback)]\n    procedure ClearReportSelectionUsage_WhenCalled_ShouldResetToDefaultBehavior()\n    var\n        ReportSelection: Record \"Report Selections\";\n        SalesHeader: Record \"Sales Header\";\n        CDOEMailHandler: Codeunit \"CDO E-Mail Handler\";\n        RecRef: RecordRef;\n        ActualUsage: Integer;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
