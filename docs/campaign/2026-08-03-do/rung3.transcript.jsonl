{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hy2efVYNH19ggyCdnLH6DL","type":"tool_result","content":"1\tcodeunit 68874 \"CDO Aut Stat Bal Check Tests\"\n2\t{\n3\t    Subtype = Test;\n4\t    TestPermissions = Disabled;\n5\t\n6\t    var\n7\t        Assert: Codeunit Assert;\n8\t        LibraryEmailTemplate: Codeunit \"CDO Library - Email Template\";\n9\t        LibrarySetup: Codeunit \"CDO Library - Setup\";\n10\t        LibraryStatement: Codeunit \"CDO Library - Statement\";\n11\t\n12\t    [Test]\n13\t    [TransactionModel(TransactionModel::AutoRollback)]\n14\t    procedure LegacySystem_CustomerWithZeroBalance_ShouldNotCreateJournalLine()\n15\t    var\n16\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n17\t        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n18\t        Customer: Record Customer;\n19\t        FinalCount: Integer;\n20\t        InitialCount: Integer;\n21\t    begin\n22\t        // [SCENARIO] Legacy automatic statement system should not create journal lines for zero-balance customers\n23\t\n24\t        // [GIVEN] Setup customer with zero balance and automatic statement configuration\n25\t        LibrarySetup.InitializeCDOSetup();\n26\t        LibraryStatement.ClearStatementJournalLines();\n27\t        LibraryStatement.CreateCustomerWithZeroBalance(Customer);\n28\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n29\t        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n30\t\n31\t        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n32\t\n33\t        // [WHEN] Automatic statement creation is triggered\n34\t        Customer.CreateAutomaticPeriodStatement();\n35\t\n36\t        // [THEN] No journal line should be created for zero-balance customer\n37\t        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n38\t        Assert.AreEqual(InitialCount, FinalCount, 'No journal line should be created for zero-balance customer');\n39\t    end;\n40\t\n41\t    [Test]\n42\t    [TransactionModel(TransactionModel::AutoRollback)]\n43\t    procedure LegacySystem_CustomerWithBalance_ShouldCreateJournalLine()\n44\t    var\n45\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n46\t        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n47\t        StatementJournalLine: Record \"CDO Statement Journal Line\";\n48\t        Customer: Record Customer;\n49\t        FinalCount: Integer;\n50\t        InitialCount: Integer;\n51\t    begin\n52\t        // [SCENARIO] Legacy automatic statement system should create journal lines for customers with balance\n53\t\n54\t        // [GIVEN] Setup customer with positive balance and automatic statement configuration\n55\t        LibrarySetup.InitializeCDOSetup();\n56\t        LibraryStatement.ClearStatementJournalLines();\n57\t        LibraryStatement.MockStatementForCustomerWithAmountAndPostingDate(Customer, 1000, CalcDate('<-2M>', WorkDate()));\n58\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n59\t        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n60\t\n61\t        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n62\t\n63\t        // [WHEN] Automatic statement creation is triggered\n64\t        Customer.CreateAutomaticPeriodStatement();\n65\t\n66\t        // [THEN] Journal line should be created for customer with balance\n67\t        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n68\t        Assert.AreEqual(InitialCount + 1, FinalCount, 'Journal line should be created for customer with balance');\n69\t\n70\t        // [AND] The journal line should have PDF content\n71\t        StatementJournalLine.SetRange(\"Customer No.\", Customer.\"No.\");\n72\t        if StatementJournalLine.FindLast() then\n73\t            Assert.IsTrue(StatementJournalLine.HasPDF(), 'Journal line should have PDF content');\n74\t    end;\n75\t\n76\t    [Test]\n77\t    [TransactionModel(TransactionModel::AutoRollback)]\n78\t    procedure CustomerWithEntriesButZeroBalance_ShouldNotCreateJournalLine()\n79\t    var\n80\t        EmailTemplateHeader: Record \"CDO E-Mail Template Header\";\n81\t        SendCustomerStatement: Record \"CDO Send Customer Statement\";\n82\t        Customer: Record Customer;\n83\t        FinalCount: Integer;\n84\t        InitialCount: Integer;\n85\t    begin\n86\t        // [SCENARIO] Customer with entries but zero net balance should not create journal line when condition is \"Balance\"\n87\t\n88\t        // [GIVEN] Setup customer with entries that result in zero balance\n89\t        LibrarySetup.InitializeCDOSetup();\n90\t        LibraryStatement.ClearStatementJournalLines();\n91\t        LibraryStatement.MockStatementForCustomerWithAmount(Customer, 0);\n92\t        LibraryStatement.CreateSendCustomerStatementSetup(SendCustomerStatement, EmailTemplateHeader, SendCustomerStatement.\"Send statement if\"::Balance);\n93\t        LibraryStatement.SetupCustomerForAutomaticStatements(Customer, SendCustomerStatement.Code);\n94\t\n95\t        InitialCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n96\t\n97\t        // [WHEN] Automatic statement creation is triggered\n98\t        Customer.CreateAutomaticPeriodStatement();\n99\t\n100\t        // [THEN] No journal line should be created\n101\t        FinalCount := LibraryStatement.GetStatementJournalLineCount(Customer.\"No.\");\n102\t        Assert.AreEqual(InitialCount, FinalCount, 'No journal line should be created for customer with zero net balance');\n103\t    end;\n104\t\n105\t    [Test]\n106\t    [TransactionModel(TransactionModel::AutoRollback)]\n107\t 