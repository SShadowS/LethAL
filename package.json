{
  "name": "lethal",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --build --force",
    "compile:fixtures": "bun scripts/compile-fixtures.ts",
    "lint": "biome check .",
    "build:binary": "bun scripts/build-binary.ts",
    "build:binaries": "bun scripts/build-binary.ts --all",
    "itest:alrunner": "bun packages/runner/itest/al-runner.itest.ts",
    "itest:bcdev": "bun packages/runner/itest/bcdev.itest.ts",
    "itest:envtool": "bun packages/runner/itest/envtool.itest.ts",
    "itest:growth": "bun packages/runner/itest/growth.itest.ts",
    "itest:lease": "bun packages/runner/itest/lease.itest.ts",
    "itest:stale-publish": "bun packages/runner/itest/stale-publish.itest.ts",
    "itest:tables": "bun packages/runner/itest/tables.itest.ts",
    "itest:hang": "bun packages/runner/itest/hang.itest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3",
    "@types/bun": "latest"
  }
}
