{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "data": {}
      },
      "required": [
        "schemaVersion",
        "warnings",
        "status",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "category": {
              "type": "string",
              "enum": [
                "validation",
                "configuration",
                "auth",
                "network",
                "state",
                "server",
                "protocol",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "nextSteps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "code",
            "category",
            "message",
            "retryable",
            "details",
            "nextSteps"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "warnings",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
