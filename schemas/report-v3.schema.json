{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SShadowS/LethAL/blob/master/schemas/report-v3.schema.json",
  "title": "LethAL session report",
  "description": "The JSON report a run writes with --out. GENERATED from the SessionReport TypeScript declaration by scripts/generate-schemas.ts — edit the type, not this file. It describes the shape THIS build writes: additive fields do not bump schemaVersion, so a report written by an older build of the same version can lack a property this schema requires. Read `validity` before quoting `mutationScore`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "validity",
    "survivorsByProcedure",
    "testFiles",
    "backend",
    "authoritative",
    "baselineGreen",
    "batches",
    "counts",
    "mutationScore",
    "mutants",
    "unsupportedTests",
    "notInstrumented",
    "declarativeSites",
    "timings",
    "preprocessorSymbols",
    "untargetedTriggerCount",
    "unplaceableCount",
    "unplaceableMutants"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliability",
        "caveats",
        "scoreDescribes",
        "baselineTests",
        "scoredMutants",
        "executionContexts"
      ],
      "properties": {
        "reliability": {
          "type": "string",
          "enum": [
            "full",
            "narrowed",
            "degraded",
            "narrowed-degraded"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseline-red",
              "narrowed",
              "operator-narrowed",
              "line-narrowed",
              "tests-narrowed",
              "uninstrumentable-files",
              "files-refused",
              "stale-test-app",
              "tests-permission-refused",
              "tests-testpage-unsupported",
              "tests-testpage-refused",
              "tests-restrictive-default-at-risk",
              "session-kind-mismatch",
              "runner-disagreement",
              "stop-hung-sessions",
              "stop-answer-400",
              "resumed",
              "untargeted-triggers",
              "attribution-unplaceable",
              "platform-artifact-kills",
              "kills-without-assertion",
              "declarative-sites-dropped",
              "all-errors",
              "some-errors",
              "session-warm",
              "preproc-files-refused",
              "tests-compiled-out",
              "test-symbols-unverified",
              "project-symlink-skipped",
              "baseline-test-stopped",
              "al-runner-v3-serve-default-fallback",
              "al-runner-v3-serve-default-fallback-warmup",
              "al-runner-v3-coverage-off",
              "time-budget-reached",
              "nondebuggable-no-coverage",
              "withheld-kills",
              "isolated-recheck-kills",
              "workdate-changed",
              "survivors-beside-unrun-tests"
            ]
          }
        },
        "scoreDescribes": {
          "type": "string"
        },
        "baselineTests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "failing"
          ],
          "properties": {
            "total": {
              "type": "number"
            },
            "failing": {
              "type": "number"
            }
          }
        },
        "scoredMutants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scored",
            "recorded"
          ],
          "properties": {
            "scored": {
              "type": "number"
            },
            "recorded": {
              "type": "number"
            }
          }
        },
        "executionContexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runner",
              "guiAllowed",
              "clientType",
              "basis",
              "verdictCount"
            ],
            "properties": {
              "runner": {
                "type": "string",
                "enum": [
                  "fenced",
                  "client-services"
                ]
              },
              "guiAllowed": {
                "type": "boolean"
              },
              "clientType": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "verdictCount": {
                "type": "number"
              },
              "runnerBuild": {
                "type": "string"
              },
              "binarySha256": {
                "type": "string"
              },
              "runSeed": {
                "type": "number"
              },
              "isolateTests": {
                "const": true
              },
              "noClient": {
                "const": true
              },
              "environment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "source"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "enum": [
                      "saas",
                      "onprem"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "config",
                      "launch.json"
                    ]
                  }
                }
              },
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                }
              },
              "companies": {
                "type": "string"
              },
              "refusedCutTail": {
                "const": true
              },
              "stopGroups": {
                "const": true
              }
            }
          }
        }
      }
    },
    "survivorsByProcedure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "codeunitName",
          "procedureName",
          "survived",
          "noCoverage",
          "killed",
          "survivorCodes"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "codeunitName": {
            "type": "string"
          },
          "procedureName": {
            "type": "string"
          },
          "coverageArmNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "survived": {
            "type": "number"
          },
          "noCoverage": {
            "type": "number"
          },
          "killed": {
            "type": "number"
          },
          "survivorCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "testFiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "testMethods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "lineAmbiguous": {
            "const": true
          },
          "baselineDurationMs": {
            "type": "number"
          },
          "baselineFlagged": {
            "const": true
          },
          "baselineFlaggedUnknown": {
            "const": true
          }
        }
      }
    },
    "costlyTests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "carriedMutants",
        "totalOwnMs",
        "ambiguousKills",
        "top"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "whole-run",
            "this-session"
          ]
        },
        "carriedMutants": {
          "type": "number"
        },
        "totalOwnMs": {
          "type": "number"
        },
        "ambiguousKills": {
          "type": "number"
        },
        "top": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test",
              "coveredMutants",
              "runs",
              "ownMs",
              "share",
              "meanMs",
              "kills",
              "killRate",
              "msUnderSurvivors"
            ],
            "properties": {
              "test": {
                "type": "string"
              },
              "coveredMutants": {
                "type": "number"
              },
              "runs": {
                "type": "number"
              },
              "ownMs": {
                "type": "number"
              },
              "share": {
                "type": "number"
              },
              "meanMs": {
                "type": "number"
              },
              "baselineMs": {
                "type": "number"
              },
              "kills": {
                "type": "number"
              },
              "killRate": {
                "type": "number"
              },
              "msUnderSurvivors": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "backend": {
      "type": "string"
    },
    "authoritative": {
      "type": "boolean"
    },
    "coverageMode": {
      "type": "string",
      "enum": [
        "none",
        "procedure",
        "line",
        "fenced",
        "al-runner"
      ]
    },
    "coverageOffFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baselineGreen": {
      "type": "boolean"
    },
    "batches": {
      "type": "number"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "killed",
        "survived",
        "noCoverage",
        "timeoutKilled",
        "knownSurvivors",
        "unstable",
        "errors",
        "deadlineExceeded"
      ],
      "properties": {
        "killed": {
          "type": "number"
        },
        "survived": {
          "type": "number"
        },
        "noCoverage": {
          "type": "number"
        },
        "timeoutKilled": {
          "type": "number"
        },
        "knownSurvivors": {
          "type": "number"
        },
        "unstable": {
          "type": "number"
        },
        "errors": {
          "type": "number"
        },
        "deadlineExceeded": {
          "type": "number"
        }
      }
    },
    "mutationScore": {
      "type": [
        "number",
        "null"
      ]
    },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutantCode",
          "file",
          "line",
          "operatorName",
          "verdict",
          "batchIndex",
          "durationMs",
          "procedureName",
          "startIndex",
          "endIndex",
          "originalText",
          "mutatedText",
          "coveringTests",
          "runner",
          "astHash",
          "codeunitName",
          "operatorMajor"
        ],
        "properties": {
          "mutantCode": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "operatorName": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "killed",
              "survived",
              "no-coverage",
              "timeout-killed",
              "known-survivor",
              "error"
            ]
          },
          "batchIndex": {
            "type": "number"
          },
          "killingTest": {
            "type": "string"
          },
          "failureNote": {
            "type": "string"
          },
          "killingTestFailure": {
            "type": "string"
          },
          "killPosition": {
            "type": "number"
          },
          "stopEvidence": {
            "type": "string",
            "enum": [
              "bc-named-stop",
              "begin-transaction-world",
              "v3-cpu-stop"
            ]
          },
          "killReproduced": {
            "const": true
          },
          "reproducedFailure": {
            "type": "string"
          },
          "cause": {
            "type": "string",
            "enum": [
              "deadline-exceeded",
              "unstable",
              "stranded",
              "result-lost",
              "group-run-error",
              "group-answer-malformed",
              "group-coverage-incomplete",
              "op-stopped",
              "stopped-after-completion",
              "stop-outcome-unconfirmed",
              "session-reused",
              "warm-prefix-unstable",
              "warm-timeout-unconfirmed",
              "warm-confirmation-incomplete",
              "reused-budget-stale",
              "timeout-unconfirmed",
              "runner-test-error",
              "runner-refused",
              "kill-not-reproduced",
              "confirm-stopped",
              "test-discovery-failed",
              "workdate-changed",
              "left-out-test-reach"
            ]
          },
          "withheldKill": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "failure"
            ],
            "properties": {
              "failure": {
                "type": "string"
              },
              "afterTest": {
                "type": "string"
              }
            }
          },
          "isolatedRecheck": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "withheldFailure",
              "killerGreenInMainBaseline"
            ],
            "properties": {
              "withheldFailure": {
                "type": "string"
              },
              "afterTest": {
                "type": "string"
              },
              "killerGreenInMainBaseline": {
                "type": "boolean"
              }
            }
          },
          "platformKillMechanism": {
            "type": "string"
          },
          "hangCapable": {
            "type": "string"
          },
          "durationMs": {
            "type": "number"
          },
          "procedureName": {
            "type": "string"
          },
          "triggerName": {
            "type": "string"
          },
          "coverageArmNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "procedureStartLine": {
            "type": "number"
          },
          "procedureEndLine": {
            "type": "number"
          },
          "gapId": {
            "type": "string"
          },
          "blockStartLine": {
            "type": "number"
          },
          "blockEndLine": {
            "type": "number"
          },
          "equivalenceRisk": {
            "type": "string"
          },
          "readerMark": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "reason"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "startIndex": {
            "type": "number"
          },
          "endIndex": {
            "type": "number"
          },
          "originalText": {
            "type": "string"
          },
          "mutatedText": {
            "type": "string"
          },
          "coveringTests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverageAttribution": {
            "type": "string",
            "enum": [
              "exact",
              "object",
              "all-green",
              "line"
            ]
          },
          "guardObserved": {
            "type": "boolean"
          },
          "reachGrain": {
            "type": "string",
            "enum": [
              "statement",
              "enclosing",
              "unplaced"
            ]
          },
          "guardReached": {
            "type": "boolean"
          },
          "reachedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carried": {
            "type": "boolean"
          },
          "runner": {
            "type": "string",
            "enum": [
              "fenced",
              "client-services"
            ]
          },
          "astHash": {
            "type": "string"
          },
          "codeunitName": {
            "type": "string"
          },
          "operatorMajor": {
            "type": "number"
          },
          "identityOrdinal": {
            "type": "number"
          }
        }
      }
    },
    "unsupportedTests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notInstrumented": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalFiles",
        "fileCount",
        "siteCount",
        "files"
      ],
      "properties": {
        "totalFiles": {
          "type": "number"
        },
        "fileCount": {
          "type": "number"
        },
        "siteCount": {
          "type": "number"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "kinds",
              "sites"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "kinds": {
                "type": "string"
              },
              "sites": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "declarativeSites": {
      "type": "object",
