                "type": "number"
              }
            }
          }
        },
        "excludedSiteCount": {
          "type": "number"
        },
        "changedSince": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "mergeBase",
            "untrackedFiles"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "mergeBase": {
              "type": "string"
            },
            "untrackedFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputPath",
        "inputSha256",
        "sample",
        "seed",
        "selected",
        "excludedSiteCount"
      ],
      "properties": {
        "inputPath": {
          "type": "string"
        },
        "inputSha256": {
          "type": "string"
        },
        "sample": {
          "type": "number"
        },
