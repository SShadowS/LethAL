        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnosis": {
          "type": "string"
        }
      }
    },
    "testPageUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "diagnosis"
      ],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnosis": {
          "type": "string"
        }
      }
    },
    "testPageRefused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "diagnosis"
