        "fileCount",
        "files"
      ],
      "properties": {
        "siteCount": {
          "type": "number"
        },
        "fileCount": {
          "type": "number"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "kinds",
              "sites"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "kinds": {
                "type": "string"
              },
              "sites": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "excludedSites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalFiles",
        "siteCount",
        "fileCount",
        "files"
      ],
      "properties": {
        "totalFiles": {
          "type": "number"
        },
        "siteCount": {
          "type": "number"
        },
        "fileCount": {
          "type": "number"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "kinds",
              "sites",
              "reason"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "kinds": {
                "type": "string"
              },
              "sites": {
                "type": "number"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "not-instrumentable",
                  "declarative",
                  "compiled-out",
                  "preproc-undecided",
                  "instrumentation-refused",
                  "hang-refused"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "only": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "excludedFileCount"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedFileCount": {
          "type": "number"
        }
      }
    },
    "exclude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "excludedFileCount"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedFileCount": {
          "type": "number"
        }
      }
    },
    "operators": {
      "type": "object",
      "additionalProperties": false,
